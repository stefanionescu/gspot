#!/usr/bin/env bash
#MISE description="Install the locked packages and the test tools, and write the docs site types."
set -euo pipefail

bun install --frozen-lockfile
mkdir -p node_modules/.test-tools
bun tests/setup/sandboxes/tool-project.ts >node_modules/.test-tools/package.json
bun install --cwd node_modules/.test-tools --linker isolated
bun --cwd docs --bun astro sync
