#!/usr/bin/env bash
#MISE description="Run one test suite: unit, integration, or e2e. With no suite, run unit."
#MISE depends=["build"]
# To run one integration or e2e file: bun `tests/setup/prepare-run.ts`, then
# bun test --preload `./tests/setup/integration.ts` <file>. Prepare again after a change under `packages/`.
set -euo pipefail

suite=${1:-unit}
if [[ ${suite} == unit ]]; then
    bun test --parallel --preload ./tests/setup/offline.ts tests/unit
else
    bun tests/setup/prepare-run.ts
    bun test --parallel --preload ./tests/setup/integration.ts "tests/${suite}"
fi
