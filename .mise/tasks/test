#!/usr/bin/env bash
#MISE description="Run one test suite: unit (the default), integration, or e2e."
#MISE depends=["build"]
# A direct bun test of an integration or e2e file needs bun tests/setup/prepare-run.ts <suite> first, and again after
# changes under packages/.
set -euo pipefail

suite=${1:-unit}
if [[ ${suite} == unit ]]; then
    bun test --parallel tests/unit
else
    bun tests/setup/prepare-run.ts "${suite}"
    bun test --parallel --preload ./tests/setup/integration.ts "tests/${suite}"
fi
