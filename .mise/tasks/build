#!/usr/bin/env bash
#MISE description="Build the CLI and the ESLint plugin, and the CLI with a copy of the root README."
#MISE depends=["packages:cli:build", "packages:eslint-plugin:build"]
set -euo pipefail

sed \
    -e 's|"docs/public/|"https://generativespotting.com/|g' \
    README.md >packages/cli/README.md
