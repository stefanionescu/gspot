#!/usr/bin/env bash
#MISE description="Print the material for the CHANGELOG.md section of a CLI version: the compare link, the breaking commits, the feat, fix, and perf subjects by scope, and the settings that changed."
#USAGE arg "<version>" help="The CLI version, such as 0.4.0"
set -euo pipefail
: "${usage_version:?mise must provide the version}"

bun .mise/release/changelog.ts "${usage_version}"
