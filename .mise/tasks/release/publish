#!/usr/bin/env bash
#MISE description="Publish the versions of both npm packages that npm does not serve yet, from a CLI tag on a commit that passed CI. Run it by hand, with the one-time code in NPM_CONFIG_OTP."
#MISE depends=["build"]
#USAGE arg "<tag>" help="The pushed CLI tag, such as v0.4.0"
set -euo pipefail
: "${usage_tag:?mise must provide the tag}"

# publish_package: Publishes a package version that npm does not serve yet.
# Arguments:
#   Package folder.
#   Package name and version.
publish_package() {
    local folder="$1"
    local spec="$2"

    if npm view "${spec}" version >/dev/null 2>&1; then
        printf '%s is already on npm.\n' "${spec}"
        return 0
    fi
    npm publish "./${folder}" || return 1
    printf 'published %s\n' "${spec}"
}

main() {
    local commit
    local tagged
    local plugin_spec
    local cli_spec

    plugin_spec=$(npm pkg get name version --prefix packages/eslint-plugin | jq -r '"\(.name)@\(.version)"') || exit 1
    cli_spec=$(npm pkg get name version --prefix packages/cli | jq -r '"\(.name)@\(.version)"') || exit 1
    if [[ ${usage_tag} != "v${cli_spec##*@}" ]]; then
        printf 'The tag %s does not name the CLI version %s.\n' "${usage_tag}" "${cli_spec##*@}" >&2
        exit 1
    fi
    commit=$(git rev-parse HEAD) || exit 1
    tagged=$(git rev-parse "${usage_tag}^{commit}") || exit 1
    # npm must serve the code of the tagged commit, so later commits on main with the same version do not ship.
    if [[ ${tagged} != "${commit}" ]]; then
        printf 'HEAD is not the commit of %s. Run git checkout %s, then publish again.\n' "${usage_tag}" "${usage_tag}" >&2
        exit 1
    fi
    mise run release:check-ci "${commit}"
    publish_package packages/eslint-plugin "${plugin_spec}"
    publish_package packages/cli "${cli_spec}"
}

main "$@"
