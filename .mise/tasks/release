#!/usr/bin/env bash
#MISE description="Publish both npm packages from a tested main commit, deploy the docs site, tag each published package, and create the GitHub release."
#MISE depends=["build"]
# npm asks for its publish approval only on a terminal, so the task keeps the terminal of the caller.
#MISE raw=true
set -euo pipefail

branch=$(git branch --show-current)
changes=$(git status --porcelain)
if [[ ${branch} != main || -n ${changes} ]]; then
    printf 'Run the release on main with no changes.\n' >&2
    exit 1
fi
commit=$(git rev-parse HEAD)
for workflow in ci.yml gspot.yml; do
    conclusion=$(gh run list --workflow "${workflow}" --commit "${commit}" --json conclusion --jq '.[0].conclusion')
    if [[ ${conclusion} != success ]]; then
        printf '%s has not passed on %s.\n' "${workflow}" "${commit}" >&2
        exit 1
    fi
done

# The plugin goes first, because the CLI pins its version. npm pkg get prints JSON strings, so the quotes go.
tags=()
for package in packages/eslint-plugin packages/cli; do
    name=$(npm pkg get name --prefix "${package}")
    version=$(npm pkg get version --prefix "${package}")
    version=${version//\"/}
    spec="${name//\"/}@${version}"
    if [[ ${package} == packages/cli ]]; then
        cli_version=${version}
        tag="v${version}"
    else
        tag="eslint-plugin-v${version}"
    fi
    tags+=("${tag}")
    if npm view "${spec}" version >/dev/null 2>&1; then
        printf '%s is already on npm.\n' "${spec}"
    else
        npm publish "./${package}"
    fi
done

# The site shows the commit that was just published.
mise run docs:deploy

for tag in "${tags[@]}"; do
    if ! git rev-parse -q --verify "refs/tags/${tag}" >/dev/null 2>&1; then
        git tag "${tag}"
    fi
    if ! git ls-remote --exit-code --tags origin "refs/tags/${tag}" >/dev/null 2>&1; then
        git push origin "${tag}"
    fi
done

if ! gh release view "v${cli_version}" >/dev/null 2>&1; then
    gh release create "v${cli_version}" --verify-tag --title "v${cli_version}" --generate-notes
fi
