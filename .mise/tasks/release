#!/usr/bin/env bash
#MISE description="Publish both npm packages from a tested main commit, deploy the docs site, tag each published package, and create the GitHub release."
#MISE raw=true
set -euo pipefail

source .mise/release/packages.sh
source .mise/release/preflight.sh
source .mise/release/notes.sh

main() (
    local work_folder
    local root
    local plugin_version
    local cli_version
    local file

    assert_release_ready
    root=$(pwd -P)
    work_folder=$(mktemp -d)
    trap 'cd -- "${root}" && { if [[ -d ${work_folder}/checkout ]]; then git worktree remove --force "${work_folder}/checkout"; fi; } && rm -rf -- "${work_folder}"' EXIT
    git worktree add --detach "${work_folder}/checkout" HEAD
    cd -- "${work_folder}/checkout" || exit 1
    export MISE_TRUSTED_CONFIG_PATHS="${work_folder}/checkout"
    mise run setup || exit 1
    mise run build || exit 1
    mise run docs:build || exit 1
    for file in packages/cli/README.md packages/cli/LICENSE.md packages/eslint-plugin/LICENSE.md; do
        if ! git diff --quiet HEAD -- "${file}"; then
            printf 'Build changed %s. Rebuild and commit the copy before release.\n' "${file}" >&2
            exit 1
        fi
    done
    plugin_version=$(package_field packages/eslint-plugin version)
    cli_version=$(package_field packages/cli version)
    publish_package packages/eslint-plugin "${plugin_version}"
    publish_package packages/cli "${cli_version}"
    bun run --cwd docs wrangler deploy || exit 1
    curl --fail --show-error --silent --location --connect-timeout 10 --max-time 30 \
        --output "${work_folder}/llms.txt" https://generativespotting.com/llms.txt || exit 1
    if ! cmp -s docs/dist/llms.txt "${work_folder}/llms.txt"; then
        printf 'https://generativespotting.com/llms.txt differs from docs/dist/llms.txt.\n' >&2
        exit 1
    fi
    publish_tags "${plugin_version}" "${cli_version}"
    printf 'Next commit: set npm:@gspothq/cli to %s in mise.toml, then run mise exec -- gspot apply and mise exec -- gspot install.\n' "${cli_version}"
)

main "$@"
