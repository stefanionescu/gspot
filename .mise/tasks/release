#!/usr/bin/env bash
#MISE description="Tag a tested main commit whose npm pins are past the release hold. Then create the GitHub release from the CHANGELOG.md section of the CLI version, and set the repository description and homepage from the CLI package."
set -euo pipefail

# shellcheck source=.mise/release/workflows.sh
source .mise/release/workflows.sh

# assert_release_commit: Refuses a release unless main has no changes and both workflows passed on HEAD.
assert_release_commit() {
    local branch
    local changes
    local commit

    branch=$(git branch --show-current) || return 1
    changes=$(git status --porcelain) || return 1
    if [[ ${branch} != main || -n ${changes} ]]; then
        printf 'Run the release on main with no changes.\n' >&2
        return 1
    fi
    commit=$(git rev-parse HEAD) || return 1
    assert_workflows_passed "${commit}"
}

# assert_version_raised: Refuses a package whose code changed since the tag of a version that npm already serves.
# Arguments:
#   Package folder.
#   Package name and version.
#   Tag of the version.
assert_version_raised() {
    local folder="$1"
    local spec="$2"
    local tag="$3"

    if npm view "${spec}" version >/dev/null 2>&1 && ! git diff --quiet "${tag}" HEAD -- "${folder}"; then
        printf '%s changed since %s, which npm serves. Raise its version first.\n' "${folder}" "${tag}" >&2
        return 1
    fi
}

# push_tag: Tags HEAD unless the tag exists, and pushes the tag unless origin has it.
# Arguments:
#   Tag name.
push_tag() {
    local tag="$1"
    local remote_tag

    if ! git rev-parse -q --verify "refs/tags/${tag}" >/dev/null; then
        git tag "${tag}" || return 1
    fi
    remote_tag=$(git ls-remote --tags origin "refs/tags/${tag}") || return 1
    if [[ -z ${remote_tag} ]]; then
        git push origin "${tag}" || return 1
    fi
}

# print_changelog_section: Prints the CHANGELOG.md section of a CLI version without its heading.
# Arguments:
#   CLI version.
# Returns:
#   1 when CHANGELOG.md has no section for the version.
print_changelog_section() {
    local version="$1"
    local line
    local is_inside=false
    local is_found=false

    while IFS= read -r line || [[ -n ${line} ]]; do
        if [[ ${line} == '## '* ]]; then
            is_inside=false
            if [[ ${line} == "## ${version}" ]]; then
                is_inside=true
                is_found=true
                continue
            fi
        fi
        if [[ ${is_inside} == true ]]; then
            printf '%s\n' "${line}"
        fi
    done <CHANGELOG.md
    if [[ ${is_found} != true ]]; then
        printf 'CHANGELOG.md has no section for %s. Write it by hand, then commit it with the version.\n' "${version}" >&2
        return 1
    fi
}

# create_release: Creates the GitHub release of a CLI tag unless it exists.
# Arguments:
#   CLI tag.
#   Release notes.
create_release() {
    local tag="$1"
    local notes="$2"

    if gh release view "${tag}" >/dev/null 2>&1; then
        return 0
    fi
    gh release create "${tag}" --verify-tag --title "${tag}" --notes "${notes}" || return 1
}

main() {
    local plugin_spec
    local cli_spec
    local plugin_tag
    local cli_tag
    local notes
    local description
    local homepage

    assert_release_commit
    plugin_spec=$(npm pkg get name version --prefix packages/eslint-plugin | jq -r '"\(.name)@\(.version)"') || exit 1
    cli_spec=$(npm pkg get name version --prefix packages/cli | jq -r '"\(.name)@\(.version)"') || exit 1
    plugin_tag="eslint-plugin-v${plugin_spec##*@}"
    cli_tag="v${cli_spec##*@}"
    assert_version_raised packages/eslint-plugin "${plugin_spec}" "${plugin_tag}"
    assert_version_raised packages/cli "${cli_spec}" "${cli_tag}"
    notes=$(print_changelog_section "${cli_spec##*@}")
    bun packages/cli/scripts/pin-ages.ts || exit 1
    push_tag "${plugin_tag}"
    push_tag "${cli_tag}"
    create_release "${cli_tag}" "${notes}"
    description=$(npm pkg get description --prefix packages/cli | jq -r .) || exit 1
    homepage=$(npm pkg get homepage --prefix packages/cli | jq -r .) || exit 1
    gh repo edit --description "${description}" --homepage "${homepage}" || exit 1
}

main "$@"
