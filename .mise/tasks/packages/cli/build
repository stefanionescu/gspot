#!/usr/bin/env bash
#MISE description="Build the CLI into a clean dist folder: bundle gspot.js and the PurgeCSS child process, and download the grammars and their licenses."
#MISE dir="{{config_root}}/packages/cli"
set -euo pipefail

# download_verified_file: Downloads a file unless it already matches its SHA-256 checksum, and checks the download.
# Arguments:
#   SHA-256 checksum.
#   Target file.
#   Source URL.
download_verified_file() {
    local checksum="$1"
    local file="$2"
    local url="$3"

    if ! sha256sum -c - <<<"${checksum}  ${file}" >/dev/null 2>&1; then
        curl --fail --silent --show-error --location --connect-timeout 10 --max-time 60 --output "${file}" "${url}"
        sha256sum -c - <<<"${checksum}  ${file}"
    fi
}

# download_grammars: Downloads the tree-sitter grammars and their licenses unless they already match their checksums.
download_grammars() {
    mkdir -p grammars/licenses
    download_verified_file 8292919c88a0f7d3fb31d0cd0253ca5a9531bc1ede82b0537f2c63dd8abe6a7a grammars/bash.wasm \
        https://github.com/tree-sitter/tree-sitter-bash/releases/download/v0.25.1/tree-sitter-bash.wasm
    download_verified_file 49bf33cf78ef5897e4e161ce1517df7de1ae5042a65b6bcfd44401e0fc606559 \
        grammars/licenses/tree-sitter-bash.txt \
        https://raw.githubusercontent.com/tree-sitter/tree-sitter-bash/a06c2e4415e9bc0346c6b86d401879ffb44058f7/LICENSE
    download_verified_file 8a23977fe271357cce6f254ef88c9bebf3854602d8046605aef6a45c02135c59 grammars/css.wasm \
        https://github.com/tree-sitter/tree-sitter-css/releases/download/v0.25.0/tree-sitter-css.wasm
    download_verified_file c5cfb43042b6b72045f4ba997834d0a7786d2793d91680868b5815b39f14fc78 \
        grammars/licenses/tree-sitter-css.txt \
        https://raw.githubusercontent.com/tree-sitter/tree-sitter-css/dda5cfc5722c429eaba1c910ca32c2c0c5bb1a3f/LICENSE
    download_verified_file c48fcd82c7ea8bf943180088ba7f28c48b2bb5287874179168bf9d31e394cf85 grammars/html.wasm \
        https://github.com/tree-sitter/tree-sitter-html/releases/download/v0.23.2/tree-sitter-html.wasm
    download_verified_file 2e0110e07abef7c2548b26ec9d6969775617ca539a0dc8dbeeb14d6452c711d1 \
        grammars/licenses/tree-sitter-html.txt \
        https://raw.githubusercontent.com/tree-sitter/tree-sitter-html/5a5ca8551a179998360b4a4ca2c0f366a35acc03/LICENSE
    download_verified_file 5fb488d0cabb4775a594bab85682de5ad6ce83c0d6ac997a9f82dd084d571240 grammars/javascript.wasm \
        https://github.com/tree-sitter/tree-sitter-javascript/releases/download/v0.25.0/tree-sitter-javascript.wasm
    download_verified_file 2e0110e07abef7c2548b26ec9d6969775617ca539a0dc8dbeeb14d6452c711d1 \
        grammars/licenses/tree-sitter-javascript.txt \
        https://raw.githubusercontent.com/tree-sitter/tree-sitter-javascript/44c892e0be055ac465d5eeddae6d3e194424e7de/LICENSE
    download_verified_file 16108b50df4ee9a30168794252ab55e7c93bfc5765d7fa0aa3e335752c515f47 grammars/python.wasm \
        https://github.com/tree-sitter/tree-sitter-python/releases/download/v0.25.0/tree-sitter-python.wasm
    download_verified_file d724405ce238a22c0d35769c5a36b386ad5958192efe8bbb304fb2896254575f \
        grammars/licenses/tree-sitter-python.txt \
        https://raw.githubusercontent.com/tree-sitter/tree-sitter-python/293fdc02038ee2bf0e2e206711b69c90ac0d413f/LICENSE
    download_verified_file 778025db5a8be0e70f8ccc3671e486dfeddd048c25d9e8a70c26de2e1bf6f97d grammars/typescript.wasm \
        https://github.com/tree-sitter/tree-sitter-typescript/releases/download/v0.23.2/tree-sitter-typescript.wasm
    download_verified_file 79e5da75ea62855a0cd67177685f0164eac87d5f630b3cbe1e0a099751ad30f8 grammars/tsx.wasm \
        https://github.com/tree-sitter/tree-sitter-typescript/releases/download/v0.23.2/tree-sitter-tsx.wasm
    download_verified_file 49bf33cf78ef5897e4e161ce1517df7de1ae5042a65b6bcfd44401e0fc606559 \
        grammars/licenses/tree-sitter-typescript.txt \
        https://raw.githubusercontent.com/tree-sitter/tree-sitter-typescript/f975a621f4e7f532fe322e13c4f79495e0a7b2e7/LICENSE
    download_verified_file 0258a7ef17303a8079ffe0748b3583d59656b5c3e8653fca7b6451b3e6689eb2 grammars/swift.wasm \
        https://github.com/alex-pinkus/tree-sitter-swift/releases/download/0.7.3/tree-sitter-swift.wasm
    download_verified_file 3533cec129bb4bba015c0d61d86dd7c3b7e82110e4d2ff7837a01eff5bad5ccc \
        grammars/licenses/tree-sitter-swift.txt \
        https://raw.githubusercontent.com/alex-pinkus/tree-sitter-swift/b8b22bffbb3441780e6471665bacfb263741c86a/LICENSE
}

main() {
    mkdir -p dist
    rm -f -- dist/*
    {
        printf '%s\n' '#!/usr/bin/env node'
        bun build src/bin.ts --target node --format esm --packages external
    } >dist/gspot.js
    chmod +x dist/gspot.js
    bun build src/checks/framework/site/purgecss-process.ts --outdir dist --target node --format esm --packages external
    download_grammars
}

main "$@"
