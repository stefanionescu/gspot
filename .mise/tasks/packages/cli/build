#!/usr/bin/env bash
#MISE description="Build the CLI into a clean dist folder."
#MISE dir="{{config_root}}/packages/cli"
set -euo pipefail

main() {
    mkdir -p dist
    rm -f -- dist/*
    {
        printf '%s\n' '#!/usr/bin/env node'
        bun build src/bin.ts --target node --format esm --external typescript --external web-tree-sitter \
            --external libpg-query --minify-whitespace --minify-syntax --metafile=dist/bundle.json
    } >dist/gspot.js
    chmod +x dist/gspot.js
    bun ../../.mise/release/notices.ts dist/bundle.json dist/THIRD-PARTY-NOTICES.md
    rm -f -- dist/bundle.json
    bun build src/configurations/framework/site/checks/purgecss-process.ts --outdir dist --target node --format esm \
        --minify-whitespace --minify-syntax
}

main "$@"
