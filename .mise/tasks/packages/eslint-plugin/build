#!/usr/bin/env bash
#MISE description="Build the ESLint plugin into dist/plugin.js, and copy the root license."
#MISE dir="{{config_root}}/packages/eslint-plugin"
set -euo pipefail

bun build src/plugin.ts --outdir dist --target node --format esm --packages external
# npm packs only the package folder, so the package gets its own copy of the root license.
cp ../../LICENSE.md LICENSE.md
