#!/usr/bin/env bash
#MISE description="Build the ESLint plugin into dist/plugin.js, and check its copy of the license."
#MISE dir="{{config_root}}/packages/eslint-plugin"
set -euo pipefail

bun build src/plugin.ts --outdir dist --target node --format esm --packages external
# npm packs only the package folder, so the package keeps its own copy of the root license.
if ! cmp -s ../../LICENSE.md LICENSE.md; then
    printf 'LICENSE.md differs from the root LICENSE.md. Copy the root file over it.\n' >&2
    exit 1
fi
