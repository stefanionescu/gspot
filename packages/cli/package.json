{
    "name": "@gspothq/cli",
    "version": "0.1.0",
    "publishConfig": {
        "access": "public"
    },
    "description": "Lint AI-generated code and install rules for AI coding agents.",
    "license": "Apache-2.0",
    "author": "Stefan Ionescu",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stefanionescu/gspot.git",
        "directory": "packages/cli"
    },
    "homepage": "https://generativespotting.com",
    "keywords": [
        "lint",
        "linter",
        "ai",
        "coding-agents",
        "git-hooks",
        "eslint",
        "cli"
    ],
    "type": "module",
    "bin": {
        "gspot": "dist/gspot.js"
    },
    "exports": {
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "configurations",
        "grammars"
    ],
    "engines": {
        "node": ">=24.2.0"
    },
    "imports": {
        "#cli/*": "./src/*",
        "#cli-package": "./package.json"
    },
    "dependencies": {
        "@clack/prompts": "1.8.0",
        "@commander-js/extra-typings": "15.0.0",
        "@decimalturn/toml-patch": "3.0.5",
        "@formatjs/icu-messageformat-parser": "2.11.4",
        "@manypkg/tools": "2.1.2",
        "@npmcli/config": "10.12.0",
        "@pgsql/types": "18.0.0",
        "@yarnpkg/parsers": "3.1.0",
        "commander": "15.0.0",
        "diff": "9.0.0",
        "entities": "7.0.1",
        "env-paths": "4.0.0",
        "eta": "4.6.0",
        "execa": "9.6.1",
        "fastest-levenshtein": "1.0.16",
        "ignore": "7.0.9",
        "jsonc-parser": "3.3.1",
        "libpg-query": "18.1.4",
        "mdast-util-from-markdown": "2.0.3",
        "mdast-util-to-string": "4.0.0",
        "nypm": "0.6.10",
        "p-limit": "7.3.2",
        "picocolors": "1.1.1",
        "picomatch": "4.0.7",
        "postcss": "8.5.28",
        "postcss-selector-parser": "7.1.6",
        "prettier": "3.8.1",
        "scule": "1.3.0",
        "semver": "7.8.5",
        "signal-exit": "4.1.0",
        "smol-toml": "1.9.0",
        "spdx-expression-parse": "5.0.0",
        "spdx-satisfies": "6.0.0",
        "std-env": "4.2.0",
        "typescript": "5.9.3",
        "unist-util-visit": "5.1.0",
        "web-tree-sitter": "0.27.0",
        "which": "7.0.0",
        "yaml": "2.9.0",
        "zod": "4.6.2"
    },
    "devDependencies": {
        "@bacons/xcode": "1.0.0-alpha.33",
        "@types/mdast": "4.0.4",
        "@types/npmcli__config": "6.0.4",
        "@types/picomatch": "4.0.2",
        "@types/semver": "7.7.1",
        "tree-sitter-bash": "0.25.1",
        "tree-sitter-css": "0.25.0",
        "tree-sitter-html": "0.23.2",
        "tree-sitter-javascript": "0.25.0",
        "tree-sitter-python": "0.25.0",
        "tree-sitter-typescript": "0.23.2"
    },
    "sideEffects": [
        "./dist/gspot.js"
    ]
}
