{
    "name": "@gspothq/cli",
    "version": "0.3.8",
    "publishConfig": {
        "access": "public"
    },
    "description": "Lint AI-generated code and install rules for AI coding agents.",
    "license": "Apache-2.0",
    "author": "Stefan Ionescu",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stefanionescu/gspot.git",
        "directory": "packages/cli"
    },
    "homepage": "https://generativespotting.com",
    "bugs": {
        "url": "https://github.com/stefanionescu/gspot/issues"
    },
    "keywords": [
        "lint",
        "linter",
        "llm",
        "ai",
        "coding-agents"
    ],
    "type": "module",
    "bin": {
        "gspot": "dist/gspot.js"
    },
    "exports": {
        "./package.json": "./package.json"
    },
    "files": [
        "dist/purgecss-process.js",
        "src/configurations/*/*/manifest.toml",
        "src/configurations/*/*/rules/**",
        "src/configurations/*/*/files/**"
    ],
    "engines": {
        "bun": ">=1.4.3",
        "node": ">=22.22.3"
    },
    "dependencies": {
        "libpg-query": "18.1.4",
        "typescript": "5.9.3",
        "web-tree-sitter": "0.27.0"
    },
    "devDependencies": {
        "@commander-js/extra-typings": "15.0.0",
        "@decimalturn/toml-patch": "3.3.2",
        "@formatjs/icu-messageformat-parser": "2.11.4",
        "@manypkg/tools": "2.1.2",
        "@npmcli/config": "10.12.0",
        "@pgsql/types": "18.0.0",
        "@types/picomatch": "4.0.2",
        "@types/semver": "7.7.1",
        "@types/which": "3.0.4",
        "@yarnpkg/parsers": "3.1.0",
        "commander": "15.0.0",
        "diff": "9.0.0",
        "entities": "7.0.1",
        "execa": "9.6.1",
        "ignore": "7.0.9",
        "jsonc-parser": "3.3.1",
        "mdast-util-from-markdown": "2.0.3",
        "p-limit": "7.3.2",
        "picomatch": "4.0.7",
        "scule": "1.3.0",
        "semver": "7.8.5",
        "signal-exit": "4.1.0",
        "spdx-expression-parse": "5.0.0",
        "tinyglobby": "0.2.17",
        "unist-util-visit": "5.1.0",
        "which": "7.0.0",
        "yaml": "2.9.0",
        "zod": "4.6.7"
    },
    "sideEffects": true
}
