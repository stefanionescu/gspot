<%
const workspaceEntries = (scope) => entryFiles(scope).flatMap((pattern) => {
    const sign = pattern.startsWith('!') ? '!' : '';
    const path = sign === '' ? pattern : pattern.slice(1);
    if (scope === '' || path.startsWith('**/')) return [pattern];
    return path.startsWith(`${scope}/`) ? [`${sign}${path.slice(scope.length + 1)}`] : [];
});
%>
{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": <%= json(entryFiles('')) %>,
    "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
    "ignore": <%= json(['.gspot/**', 'eslint.config.{js,mjs,cjs}', ...(tool('knip').ignore ?? []).flatMap((entry) => entry.paths ?? []), ...policy.declarations.flatMap((entry) => entry.paths)]) %>,
    "ignoreDependencies": <%= json(["@gspot/eslint-plugin", "eslint-config-prettier", "prettier", "@socketsecurity/bun-security-scanner", ...toolPackages, ...(settings['tools.knip.ignore_dependencies'] ?? []).map((entry) => typeof entry === 'string' ? entry : entry.name)]) %>,
    "ignoreBinaries": <%= json([...tools, "vale", "git", "mise", "bunx", "npx"]) %>,
    "ignoreExportsUsedInFile": true,
    "workspaces": <%= json(Object.fromEntries([{ path: '' }, ...scopes].map((scope) => [scope.path === '' ? '.' : scope.path, { entry: workspaceEntries(scope.path), project: ['**/*.{ts,tsx,mts,cts,js,mjs,cjs}'] }]))) %><% const extras = extra('knip'); if (extras) { for (const [key, value] of Object.entries(extras)) { if (key !== 'reason') { %>,
    <%= json(key, 0) %>: <%= json(value) %><% } } } %>
}
