line-length = <%= format.print_width %>
indent-width = <%= format.indent_width %>
exclude = [".git", ".venv", "__pycache__", ".ruff_cache", ".pytest_cache", "build", "dist", "node_modules", ".gspot"]

[format]
preview = false
indent-style = "<%= format.indent_style === 'tab' ? 'tab' : 'space' %>"
quote-style = "double"
line-ending = "lf"
docstring-code-format = true

[lint]
<%~ toml({ select: families, ignore: [...(isAll ? ["COM812", "D203", "D213"] : []), ...off] }).trimEnd() %>
fixable = ["ALL"]
unfixable = []
preview = false
explicit-preview-rules = true

[lint.isort]
# Imports go shortest first within each section, the order every gspot language uses. python/export-order orders __all__ the same way, which is why RUF022 is not selected. RUF023 is not selected either: it sorts __slots__ alphabetically.
length-sort = true
length-sort-straight = true
force-sort-within-sections = true

[lint.mccabe]
max-complexity = <%= at('cyclomatic_complexity', 8) %>
<% if (settings['tools.ruff.docstring_convention'] !== undefined) { -%>

[lint.pydocstyle]
<%~ toml({ convention: settings['tools.ruff.docstring_convention'] }).trimEnd() %>
<% } -%>

[lint.pep8-naming]
extend-ignore-names = ["setUp", "setUpClass", "tearDown", "tearDownClass"]

[lint.pylint]
max-args = <%= at('function_parameters', 7) %>
max-positional-args = <%= at('positional_arguments', at('function_parameters', 7)) %>
max-bool-expr = <%= at('boolean_operators', 4) %>
max-branches = <%= at('branches', 8) %>
max-locals = <%= at('locals', 10) %>
max-public-methods = <%= at('public_methods', 12) %>
max-returns = <%= at('returns', 4) %>
max-statements = <%= at('statements', 30) %>
max-nested-blocks = <%= at('nesting', 3) %>
<% const testRules = settings['tools.ruff.test_ignores']; const testFiles = testRules.length > 0 ? settings['tests'] : []; if (perFile.length > 0 || testFiles.length > 0) { -%>

[lint.per-file-ignores]
<% const byPath = new Map(testFiles.map((path) => [path, testRules])); for (const entry of perFile) for (const path of entry.paths) byPath.set(path, [...(byPath.get(path) ?? []), entry.rule]); -%>
<%~ toml(Object.fromEntries(byPath)).trimEnd() %>
<% } -%>
