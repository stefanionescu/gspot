# Editors and gspot checks use the same ordered ignore patterns.
<% const adopted = tool('prettier').ignore_patterns; if (adopted !== undefined) { %><%= adopted.join('\n') %>
<% } else { %>
node_modules/
dist/
build/
coverage/
*.lock
bun.lockb
package-lock.json
pnpm-lock.yaml
yarn.lock
<% for (const file of policy.declarations.flatMap((entry) => entry.paths)) { %><%= file %>
<% } %>

<% } %>
