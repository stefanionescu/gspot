<%
const functions = configurationScopes('supabase').map(({ settings }) => `/${settings['supabase.functions_folder']}/**`);
const document = {
    rules: [
        {
            id: 'gspot.supabase.postgrest-filter-interpolation',
            patterns: [
                {
                    'pattern-either': [
                        { pattern: '$CLIENT.or(`...${$VAR}...`, ...)' },
                        { pattern: '$CLIENT.filter($COLUMN, "in", `...${$VAR}...`, ...)' },
                        { pattern: '$CLIENT.textSearch($COLUMN, `...${$VAR}...`, ...)' },
                    ],
                },
                { 'pattern-not': '$CLIENT.textSearch(..., {..., type: "plain", ...})' },
                { 'pattern-not': '$CLIENT.textSearch(..., {..., type: "phrase", ...})' },
                { 'pattern-not': '$CLIENT.textSearch(..., {..., type: "websearch", ...})' },
            ],
            message:
                'An interpolated value enters raw PostgREST filter syntax. Escape it for the operator or use a typed filter.\n',
            languages: ['typescript', 'javascript'],
            severity: 'ERROR',
            metadata: {
                cwe: ['CWE-20'],
                category: 'security',
            },
        },
        {
            id: 'gspot.supabase.edge-cors-wildcard-with-credentials',
            pattern: '{..., "Access-Control-Allow-Origin": "*", ..., "Access-Control-Allow-Credentials": "true", ...}',
            message: 'Wildcard origins cannot be used with credentialed requests. List the permitted origins.\n',
            languages: ['typescript', 'javascript'],
            severity: 'ERROR',
            paths: {
                include: [...functions],
            },
            metadata: {
                cwe: ['CWE-346'],
                category: 'security',
            },
        },
        {
            id: 'gspot.supabase.edge-unvalidated-json-body',
            patterns: [
                {
                    pattern: 'await req.json()',
                },
                {
                    'pattern-not-inside': 'const $BODY = await req.json()\n...\n$SCHEMA.parse($BODY)\n',
                },
                {
                    'pattern-not-inside': 'const $BODY = await req.json()\n...\n$SCHEMA.safeParse($BODY)\n',
                },
            ],
            message:
                'Request body consumed without schema validation. Use zod or similar to validate the parsed JSON.\n',
            languages: ['typescript', 'javascript'],
            severity: 'ERROR',
            paths: {
                include: [...functions],
            },
            metadata: {
                cwe: ['CWE-20'],
                category: 'security',
            },
        },
    ],
};
recordRules(document);
%><%~ yaml(document).trimEnd() %>
