                {
                    'metavariable-regex': {
                        metavariable: '$VAR',
                        regex: '.*(KEY|SECRET|PASSWORD|TOKEN).*',
                    },
                },
            ],
            message: 'Logging a sensitive environment variable. Remove or mask before logging.\n',
            languages: ['typescript', 'javascript'],
            severity: 'ERROR',
            metadata: {
                cwe: ['CWE-532'],
                category: 'security',
            },
        },
        {
            id: 'supabase-rls-bypass-service-role',
            pattern: 'createAdminClient(...)',
            message:
                'createAdminClient() bypasses RLS. Add a comment explaining why RLS bypass is needed for this operation.\n',
            languages: ['typescript', 'javascript'],
            severity: 'ERROR',
            metadata: {
                cwe: ['CWE-269'],
                category: 'security',
            },
        },
    ],
};
recordRules(document);
