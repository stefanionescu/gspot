timeout: <%= json(`${String(settings['tool_timeout_seconds'])}s`, 0) %>
severity:
<% for (const level of String(settings['tools.trivy.severity']).split(',')) { %>    - <%= json(level.trim(), 0) %>
<% } %>scan:
    skip-dirs:
        - node_modules
        - .gspot
        - .git
ignorefile: <%= json('.gspot/config/' + (scope === '' ? '' : scope + '/') + 'trivyignore', 0) %>
