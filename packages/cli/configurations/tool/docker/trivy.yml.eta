timeout: <%= json(`${String(settings['tool_timeout_seconds'])}s`, 0) %>
severity:
<% for (const level of settings['tools.trivy.severity']) { %>    - <%= json(level, 0) %>
<% } %>scan:
    skip-dirs:
        - node_modules
        - .gspot
        - .git
ignorefile: <%= json('.gspot/config/' + (scope === '' ? '' : scope + '/') + 'trivyignore', 0) %>
