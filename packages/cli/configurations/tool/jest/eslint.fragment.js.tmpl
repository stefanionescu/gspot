<% for (const selected of configurationScopes('jest')) { const inScope = selected.path === '' ? '**/*' : `${selected.path}/**/*`; %>
    {
        files: <%= json(selected.settings['tools.eslint.test_files'].map((pattern) => [inScope, pattern])) %>,
        plugins: { jest },
        languageOptions: { globals: jest.environments.globals.globals },
        settings: { jest: { globalPackage: <%= json(selected.settings['tools.jest.global_package']) %> } },
        rules: {
            'jest/no-focused-tests': 'error',
            'jest/no-disabled-tests': 'error',
            'jest/no-identical-title': 'error',
            'jest/no-standalone-expect': 'error',
            'jest/no-commented-out-tests': 'error',
            'jest/expect-expect': 'error',
            'jest/valid-describe-callback': 'error',
            'jest/no-conditional-expect': 'error',
            'jest/valid-expect': ['error', { maxArgs: <%= selected.settings['tools.jest.global_package'] === 'bun:test' ? 2 : 1 %> }],
            'jest/prefer-strict-equal': 'error',
        },
    },
<% if (isAll) { %>    {
        files: [<%= json(inScope) %>],
        rules: { 'gspot/tests-directory-contents': ['error', { harnessDirectory: <%= json([selected.path, selected.settings['tools.jest.harness_directory']].filter(Boolean).join('/')) %> }] },
    },
<% } } %>
