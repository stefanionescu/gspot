            ...(settings['tools.typos.exclude'] ?? []).flatMap((entry) => entry.paths),
            ...policy.declarations.flatMap((entry) => entry.paths),
        ], targetPath.startsWith('.gspot/') ? '' : scope),
    },
    type: {
        'gspot-policy': {
            'extend-glob': ['gspot.toml'],
            'extend-words': Object.fromEntries(configurationScopes('spelling').flatMap((entry) =>
