# Editors and gspot checks use the same ordered ignore patterns.
<% for (const path of ignoredPaths) { %><%= path %>
<% } %>
<% for (const pattern of policy.exclude) { %><%= pattern %>
<% } %>
<% for (const file of policy.declarations.flatMap((entry) => entry.paths)) { %><%= file %>
<% } %>
<% for (const pattern of ignoresFor('format/prettier').filter((entry) => entry.rule === undefined).flatMap((entry) => entry.paths ?? [])) { %><%= pattern %>
<% } %>
