root = true

[*]
charset = utf-8
end_of_line = <%= format.line_ending %>
insert_final_newline = <%= format.final_newline %>
trim_trailing_whitespace = true
indent_style = <%= format.indent_style %>
indent_size = <%= format.indent_width %>

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
<% const extras = verbatim('editorconfig'); if (extras) { for (const [key, value] of Object.entries(extras)) { if (typeof value === 'object' && value !== null) { %>
[<%= key %>]
<% for (const [option, setting] of Object.entries(value)) { %><%= option %> = <%= setting %>
<% } } } } %>
<% for (const entry of editorconfigOverrides()) { %>
[<%= entry.path %>]
<% for (const [key, value] of Object.entries(entry.options)) { %><%= key %> = <%= value %>
<% } } %>
