ignoreErrors: true
customCatalog:
    schemas:
        - name: mise
          description: The mise configuration file
          fileMatch:
              - mise.toml
              - .mise.toml
              - .mise/conf.d/*.toml
              - .config/mise/config.toml
              - .config/mise/conf.d/*.toml
          location: https://mise.jdx.dev/schema/mise.json
<% for (const [pattern, schema] of Object.entries(settings['tools.v8r.schemas'])) { %>        - name: <%= json(pattern) %>
          fileMatch:
              - <%= json(pattern) %>
          location: <%= json(schema) %>
<% } %>
