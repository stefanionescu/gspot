<%
const allowed = Object.fromEntries(Object.keys(policy.words).map((word) => [word, word]));
const dictionaries = configurationScopes('spelling').flatMap((entry) =>
    [entry.verbatim('typos')?.default, ...Object.values(entry.verbatim('typos')?.type ?? {})]
);
%><%~ toml({
    default: {
        locale: settings['prose.locale'],
        'extend-ignore-re': ['\\b[0-9a-f]{7,40}\\b', '\\b[A-Za-z0-9+/]{40,}={0,2}\\b'],
        'extend-identifiers': { ...allowed, ...verbatim('typos')?.default?.['extend-identifiers'] },
        'extend-words': { ...allowed, ...verbatim('typos')?.default?.['extend-words'] },
    },
    files: {
        'extend-exclude': scopeIgnorePatterns([
            '*.lock', 'bun.lockb', 'package-lock.json', 'pnpm-lock.yaml', 'yarn.lock', 'Package.resolved',
            '*.pbxproj', '*.xcstrings', '*.svg', '*.min.js', '*.min.css',
            '.gspot/config/vale/',
            ...ignoresFor('spelling/typos').filter((entry) => entry.rule === undefined).flatMap((entry) => entry.paths),
            ...policy.declarations.flatMap((entry) => entry.paths),
        ], targetPath.startsWith('.gspot/') ? '' : scope),
    },
    type: {
        ...verbatim('typos')?.type,
        'gspot-policy': {
            'extend-glob': ['gspot.toml'],
            'extend-identifiers': Object.fromEntries(dictionaries.flatMap((type) =>
                Object.keys(type?.['extend-identifiers'] ?? {}).map((identifier) => [identifier, identifier])
            )),
            'extend-words': Object.fromEntries([
                ...Object.entries(allowed),
                ...dictionaries.flatMap((type) =>
                    Object.keys(type?.['extend-words'] ?? {}).map((word) => [word, word])
                ),
            ]),
        },
    },
}).trimEnd() %>
