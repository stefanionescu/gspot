<%
const rules = isAll
    ? {
          'Vale.Spelling': 'NO',
          'Google.Spelling': 'NO',
          'Harper.Spelling': 'NO',
          'Google.Contractions': 'NO',
          'Google.Parens': 'NO',
          'Google.Passive': 'NO',
          'write-good.Passive': 'NO',
          'write-good.E-Prime': 'NO',
          'Google.Headings': 'NO',
          'Google.Acronyms': 'NO',
          'alex.ProfanityUnlikely': 'NO',
          'Harper.ExpandConfiguration': 'NO',
          'Vale.Terms': 'NO',
          'write-good.TooWordy': 'NO',
          'write-good.Weasel': 'NO',
          'Google.WordList': 'NO',
          'Google.Colons': 'NO',
          'Google.Anthropomorphism': 'NO',
          'Google.ExcessiveClaims': 'NO',
          'Google.Will': 'NO',
          'Google.Timeless': 'NO',
          'Google.Jargon': 'NO',
          'alex.Condescending': 'NO',
          'alex.Ablist': 'NO',
          'alex.ProfanityMaybe': 'NO',
          'alex.ProfanityLikely': 'NO',
          'alex.Race': 'NO',
          'alex.Suicide': 'NO',
          'proselint.Typography': 'NO',
          'proselint.Needless': 'NO',
          'Harper.ExpandMemoryShorthands': 'NO',
          'Harper.MoreAdjective2': 'NO',
          'Harper.MoreAdjective4': 'NO',
          'gspot.alt-text': 'NO',
          'gspot.merge-conflict-markers': 'NO',
      }
    : Object.fromEntries(
          prose.rules
              .filter((style) => !['dates', 'link-text', 'alt-text'].includes(style))
              .map((style) => ['gspot.' + style, 'NO']),
      );
rules['gspot.alt-text'] = 'NO';
rules['gspot.us-english'] = isAll && settings['prose.locale'] === 'en-us' ? 'YES' : 'NO';
const document = {
    DEFAULT: {
        options: {
            StylesPath: [
                ...(isAll ? [relative(dirname(targetPath), '.gspot/vale')] : []),
                ...(isAll ? [dirname(targetPath) + '/vale/styles'] : ['vale/styles']),
                ...(relative(dirname(targetPath), '.gspot/config/vale/styles') === 'vale/styles'
                    ? []
                    : ['.gspot/config/vale/styles']),
            ],
            MinAlertLevel: 'suggestion',
            SkippedScopes: 'script, style, pre, figure, table',
            ...(isAll ? { Packages: prose.packages.join(', ') } : {}),
            Vocab: 'words',
        },
    },
    formats: { options: Object.fromEntries(prose.formats) },
    '*': {
        BasedOnStyles: isAll ? ['Vale', 'gspot', ...prose.packages] : ['gspot'],
        options: { BlockIgnores: prose.blockIgnores.join(', '), TokenIgnores: prose.tokenIgnores.join(', ') },
        rules,
    },
    '*.{md,mdx,html,htm,astro,svelte,vue}': {
        rules: { 'gspot.alt-text': 'YES', ...(isAll ? { 'gspot.merge-conflict-markers': 'YES' } : {}) },
    },
};
for (const entry of configurationScopes('prose')) {
    if (entry.path !== '') document[entry.path + '/**'] = {
        rules: { 'gspot.us-english': isAll && entry.settings['prose.locale'] === 'en-us' ? 'YES' : 'NO' },
    };
}
const comments = {
    'Vale.Spelling': '# "typos owns spelling"',
    'Google.Spelling': '# "typos owns spelling"',
    'Harper.Spelling': '# "typos owns spelling"',
    'Google.Contractions': '# "The project selects its contraction style; the tool must not force contractions."',
    'Google.Parens': '# "the rule files allow parentheses"',
    'Google.Passive': '# "the rule files allow the passive when the result matters more than the actor"',
    'write-good.Passive': '# "the rule files allow the passive when the result matters more than the actor"',
    'write-good.E-Prime': '# "the rule files have no rule against forms of to be"',
    'Google.Headings': '# "gspot.heading-case owns heading case"',
    'Google.Acronyms': '# "gspot.acronyms owns acronyms"',
    'alex.ProfanityUnlikely': '# "it flags execute, kill and abort, which are the words for those actions"',
    'Harper.ExpandConfiguration': '# "config is a reserved word in the naming policy and a path in every repository"',
    'Vale.Terms':
        '# "the vocabulary accepts spellings; it does not fix case, because configuration ids are the lowercase tool names"',
    'write-good.TooWordy': '# "it flags validate, multiple and it is, which are plain words"',
    'write-good.Weasel': '# "gspot.hedging owns hedges; this flags several and tiny"',
    'Google.WordList': '# "Google product terminology: command-line tool for CLI"',
    'Google.Colons': '# "it lowercases acronyms after a colon"',
    'Google.Anthropomorphism': '# "a check sees, a tool tells; the rule files describe tools as actors"',
    'Google.ExcessiveClaims': '# "guarantee is a technical word for what a check makes certain"',
    'Google.Will': '# "gspot.future owns the future tense"',
    'Google.Timeless': '# "gspot.history owns time words"',
    'Google.Jargon': '# "camel case is the name of the case"',
    'alex.Condescending': '# "obvious, simple and clearly are words the rule files use to state that something is"',
    'alex.Ablist': '# "it flags disabled, as in a disabled rule"',
    'alex.ProfanityMaybe': '# "swallow, trap and abuse are what code does to errors, signals and inputs"',
    'alex.ProfanityLikely': '# "looser is a comparative"',
    'alex.Race': '# "primitive is a type"',
    'alex.Suicide': '# "a process hangs"',
    'proselint.Typography': '# "three dots stay ASCII"',
    'proselint.Needless': '# "oversized and extensible are the words"',
    'Harper.ExpandMemoryShorthands': '# "MB and GB are the units"',
    'Harper.MoreAdjective2': '# "it reports that an inflected form exists, which is not an error"',
    'Harper.MoreAdjective4': '# "it reports that an inflected form exists, which is not an error"',
    'gspot.alt-text':
        '# "an image without alternative text and a merge conflict marker are markup facts; a code string that quotes them is not"',
};
recordRules(document);
%><% for (const [name, section] of Object.entries(document)) { if (name !== 'DEFAULT') { %>[<%= name %>]
<% } if (section.BasedOnStyles) { %>BasedOnStyles = <%= section.BasedOnStyles.join(', ') %>
<% } for (const [key, values] of Object.entries(section.options ?? {})) { for (const value of [values].flat()) { %><%= key %> = <%= value %>
<% } } for (const [rule, value] of Object.entries(section.rules ?? {})) { if (name === '*' && comments[rule]) { %><%= comments[rule] %>
<% } %><%= rule %> = <%= value %>
<% } %>
<% } %>
