<%
const rules = isAll
    ? {
          'Vale.Spelling': 'NO',
          'Google.Spelling': 'NO',
          'Microsoft.Spelling': 'NO',
          'RedHat.Spelling': 'NO',
          'Harper.Spelling': 'NO',
          'Google.Contractions': 'NO',
          'Microsoft.Contractions': 'NO',
          'Google.Parens': 'NO',
          'Google.Passive': 'NO',
          'Microsoft.Passive': 'NO',
          'RedHat.PassiveVoice': 'NO',
          'write-good.Passive': 'NO',
          'write-good.E-Prime': 'NO',
          'Google.Headings': 'NO',
          'Microsoft.Headings': 'NO',
          'RedHat.Headings': 'NO',
          'Microsoft.SentenceLength': 'NO',
          'RedHat.SentenceLength': 'NO',
          'Google.Acronyms': 'NO',
          'Microsoft.Acronyms': 'NO',
          'RedHat.PascalCamelCase': 'NO',
          'RedHat.Definitions': 'NO',
          'alex.ProfanityUnlikely': 'NO',
          'Harper.ExpandConfiguration': 'NO',
          'Vale.Terms': 'NO',
          'write-good.TooWordy': 'NO',
          'write-good.Weasel': 'NO',
          'RedHat.TermsSuggestions': 'NO',
          'RedHat.TermsWarnings': 'NO',
          'RedHat.TermsErrors': 'NO',
          'RedHat.SimpleWords': 'NO',
          'RedHat.DoNotUseTerms': 'NO',
          'RedHat.Hyphens': 'NO',
          'RedHat.GitLinks': 'NO',
          'RedHat.ReadabilityGrade': 'NO',
          'RedHat.UserReplacedValues': 'NO',
          'RedHat.Using': 'NO',
          'RedHat.EmDash': 'NO',
          'RedHat.Symbols': 'NO',
          'RedHat.OxfordComma': 'NO',
          'RedHat.RepeatedWords': 'NO',
          'RedHat.Spacing': 'NO',
          'RedHat.Ellipses': 'NO',
          'Microsoft.Vocab': 'NO',
          'Microsoft.Terms': 'NO',
          'Microsoft.GeneralURL': 'NO',
          'Microsoft.Accessibility': 'NO',
          'Microsoft.HeadingAcronyms': 'NO',
          'Microsoft.HeadingColons': 'NO',
          'Microsoft.Uppercase': 'NO',
          'Microsoft.Wordiness': 'NO',
          'Microsoft.OxfordComma': 'NO',
          'Microsoft.Ellipses': 'NO',
          'Microsoft.Hyphens': 'NO',
          'Microsoft.Quotes': 'NO',
          'Microsoft.Plurals': 'NO',
          'Microsoft.FirstPerson': 'NO',
          'Microsoft.We': 'NO',
          'Microsoft.Foreign': 'NO',
          'Microsoft.Spacing': 'NO',
          'Microsoft.Avoid': 'NO',
          'Microsoft.UIVerbs': 'NO',
          'Google.WordList': 'NO',
          'Google.Colons': 'NO',
          'Google.Anthropomorphism': 'NO',
          'Google.ExcessiveClaims': 'NO',
          'Google.Will': 'NO',
          'Google.Timeless': 'NO',
          'Google.Jargon': 'NO',
          'alex.Condescending': 'NO',
          'alex.Ablist': 'NO',
          'alex.ProfanityMaybe': 'NO',
          'alex.ProfanityLikely': 'NO',
          'alex.Race': 'NO',
          'alex.Suicide': 'NO',
          'proselint.Typography': 'NO',
          'proselint.Needless': 'NO',
          'Harper.ExpandMemoryShorthands': 'NO',
          'Harper.MoreAdjective2': 'NO',
          'Harper.MoreAdjective4': 'NO',
          'gspot.alt-text': 'NO',
          'RedHat.MergeConflictMarkers': 'NO',
      }
    : Object.fromEntries(
          prose.rules
              .filter((style) => !['dates', 'link-text', 'alt-text'].includes(style))
              .map((style) => ['gspot.' + style, 'NO']),
      );
rules['gspot.alt-text'] = 'NO';
rules['gspot.us-english'] = isAll && settings['prose.locale'] === 'en-us' ? 'YES' : 'NO';
const document = {
    DEFAULT: {
        options: {
            StylesPath: relative(dirname(targetPath), '.gspot/config/vale/styles') === 'vale/styles'
                ? 'vale/styles'
                : ['vale/styles', '.gspot/config/vale/styles'],
            MinAlertLevel: 'suggestion',
            SkippedScopes: 'script, style, pre, figure, table',
            ...(isAll ? { Packages: prose.packages.join(', ') } : {}),
            Vocab: 'words',
        },
    },
    formats: { options: Object.fromEntries(prose.formats) },
    '*': {
        BasedOnStyles: isAll ? ['Vale', 'gspot', ...prose.packages] : ['gspot'],
        options: { BlockIgnores: prose.blockIgnores.join(', '), TokenIgnores: prose.tokenIgnores.join(', ') },
        rules,
    },
    '*.{md,mdx,html,htm,astro,svelte,vue}': {
        rules: { 'gspot.alt-text': 'YES', ...(isAll ? { 'RedHat.MergeConflictMarkers': 'YES' } : {}) },
    },
};
for (const entry of configurationScopes('prose')) {
    if (entry.path !== '') document[entry.path + '/**'] = {
        rules: { 'gspot.us-english': isAll && entry.settings['prose.locale'] === 'en-us' ? 'YES' : 'NO' },
    };
}
const comments = {
    'Vale.Spelling': '# "typos owns spelling"',
    'Google.Spelling': '# "typos owns spelling"',
    'Microsoft.Spelling': '# "typos owns spelling"',
    'RedHat.Spelling': '# "typos owns spelling"',
    'Harper.Spelling': '# "typos owns spelling"',
    'Google.Contractions': '# "The project selects its contraction style; the tool must not force contractions."',
    'Microsoft.Contractions': '# "The project selects its contraction style; the tool must not force contractions."',
    'Google.Parens': '# "the rule files allow parentheses"',
    'Google.Passive': '# "the rule files allow the passive when the result matters more than the actor"',
    'Microsoft.Passive': '# "the rule files allow the passive when the result matters more than the actor"',
    'RedHat.PassiveVoice': '# "the rule files allow the passive when the result matters more than the actor"',
    'write-good.Passive': '# "the rule files allow the passive when the result matters more than the actor"',
    'write-good.E-Prime': '# "the rule files have no rule against forms of to be"',
    'Google.Headings': '# "gspot.heading-case owns heading case"',
    'Microsoft.Headings': '# "gspot.heading-case owns heading case"',
    'RedHat.Headings': '# "gspot.heading-case owns heading case"',
    'Microsoft.SentenceLength': '# "gspot.sentence-length owns sentence length, from limits.docs.sentence_words"',
    'RedHat.SentenceLength': '# "gspot.sentence-length owns sentence length, from limits.docs.sentence_words"',
    'Google.Acronyms': '# "gspot.acronyms owns acronyms"',
    'Microsoft.Acronyms': '# "gspot.acronyms owns acronyms"',
    'RedHat.PascalCamelCase': '# "identifiers are quoted in code spans, which Vale ignores; the rest are words"',
    'RedHat.Definitions': '# "gspot.acronyms owns the first use of an acronym"',
    'alex.ProfanityUnlikely': '# "it flags execute, kill and abort, which are the words for those actions"',
    'Harper.ExpandConfiguration': '# "config is a reserved word in the naming policy and a path in every repository"',
    'Vale.Terms':
        '# "the vocabulary accepts spellings; it does not fix case, because configuration ids are the lowercase tool names"',
    'write-good.TooWordy': '# "it flags validate, multiple and it is, which are plain words"',
    'write-good.Weasel': '# "gspot.hedging owns hedges; this flags several and tiny"',
    'RedHat.TermsSuggestions': '# "Red Hat product terminology: shell prompt for shell, after for once"',
    'RedHat.TermsWarnings': '# "Red Hat product terminology: might for may, tool for tooling"',
    'RedHat.TermsErrors': '# "Red Hat product terminology: typographical error for typo"',
    'RedHat.SimpleWords': '# "Red Hat word list: many for multiple, has for contains"',
    'RedHat.DoNotUseTerms': '# "Red Hat word list: it bans overhead and colors"',
    'RedHat.Hyphens': '# "Red Hat spellings: nonzero, noninteractive"',
    'RedHat.GitLinks': '# "links to GitHub are how tools are cited"',
    'RedHat.ReadabilityGrade': '# "text about tools scores as hard reading; the length rules own readability"',
    'RedHat.UserReplacedValues': '# "placeholders are written <kebab-case>"',
    'RedHat.Using': '# "a Red Hat grammar preference"',
    'RedHat.EmDash': '# "gspot.dashes owns dashes"',
    'RedHat.Symbols': '# "an exclamation mark is a character, not a symbol to avoid"',
    'RedHat.OxfordComma': '# "Google.OxfordComma reports the same comma"',
    'RedHat.RepeatedWords': '# "Vale.Repetition reports the same repetition"',
    'RedHat.Spacing': '# "Google.Spacing reports the same spacing"',
    'RedHat.Ellipses': '# "Google.Ellipses reports the same ellipsis"',
    'Microsoft.Vocab': '# "it asks the writer to verify a word against a list instead of stating a rule"',
    'Microsoft.Terms': '# "Microsoft product terminology: personal digital assistant for agent"',
    'Microsoft.GeneralURL': '# "URL is the word"',
    'Microsoft.Accessibility': '# "it flags disabled, as in a disabled rule"',
    'Microsoft.HeadingAcronyms': '# "headings name tools by their acronyms"',
    'Microsoft.HeadingColons': '# "gspot.heading-case owns heading case"',
    'Microsoft.Uppercase': '# "constant and file names appear in prose"',
    'Microsoft.Wordiness': '# "it rewrites extract as remove"',
    'Microsoft.OxfordComma': '# "Google.OxfordComma reports the same comma"',
    'Microsoft.Ellipses': '# "Google.Ellipses reports the same ellipsis"',
    'Microsoft.Hyphens': '# "Google.LyHyphens reports the same hyphen"',
    'Microsoft.Quotes': '# "Google.Quotes reports the same punctuation"',
    'Microsoft.Plurals': '# "Google.OptionalPlurals reports the same plural"',
    'Microsoft.FirstPerson': '# "Google.FirstPerson reports the same pronoun"',
    'Microsoft.We': '# "Google.We reports the same pronoun"',
    'Microsoft.Foreign': '# "Google.Latin reports the same abbreviation"',
    'Microsoft.Spacing': '# "Google.Spacing reports the same spacing"',
    'Microsoft.Avoid': '# "Microsoft word list: it bans backend"',
    'Microsoft.UIVerbs': '# "click and swipe are the verbs for a touch screen and a mouse"',
    'Google.WordList': '# "Google product terminology: command-line tool for CLI"',
    'Google.Colons': '# "it lowercases acronyms after a colon"',
    'Google.Anthropomorphism': '# "a check sees, a tool tells; the rule files describe tools as actors"',
    'Google.ExcessiveClaims': '# "guarantee is a technical word for what a check makes certain"',
    'Google.Will': '# "gspot.future owns the future tense"',
    'Google.Timeless': '# "gspot.history owns time words"',
    'Google.Jargon': '# "camel case is the name of the case"',
    'alex.Condescending': '# "obvious, simple and clearly are words the rule files use to state that something is"',
    'alex.Ablist': '# "it flags disabled, as in a disabled rule"',
    'alex.ProfanityMaybe': '# "swallow, trap and abuse are what code does to errors, signals and inputs"',
    'alex.ProfanityLikely': '# "looser is a comparative"',
    'alex.Race': '# "primitive is a type"',
    'alex.Suicide': '# "a process hangs"',
    'proselint.Typography': '# "three dots stay ASCII"',
    'proselint.Needless': '# "oversized and extensible are the words"',
    'Harper.ExpandMemoryShorthands': '# "MB and GB are the units"',
    'Harper.MoreAdjective2': '# "it reports that an inflected form exists, which is not an error"',
    'Harper.MoreAdjective4': '# "it reports that an inflected form exists, which is not an error"',
    'gspot.alt-text':
        '# "an image without alternative text and a merge conflict marker are markup facts; a code string that quotes them is not"',
};
recordRules(document);
%><% for (const [name, section] of Object.entries(document)) { if (name !== 'DEFAULT') { %>[<%= name %>]
<% } if (section.BasedOnStyles) { %>BasedOnStyles = <%= section.BasedOnStyles.join(', ') %>
<% } for (const [key, values] of Object.entries(section.options ?? {})) { for (const value of [values].flat()) { %><%= key %> = <%= value %>
<% } } for (const [rule, value] of Object.entries(section.rules ?? {})) { if (name === '*' && comments[rule]) { %><%= comments[rule] %>
<% } %><%= rule %> = <%= value %>
<% } %>
<% } %>
