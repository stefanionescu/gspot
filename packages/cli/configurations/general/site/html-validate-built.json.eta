<%
const document = {
    extends: ['html-validate:recommended'],
    rules: Object.assign(
        {
            'no-inline-style': 'off',
            'no-raw-characters': 'off',
            'void-style': 'off',
            'doctype-style': 'off',
            'no-trailing-whitespace': 'off',
            'valid-id': ['error', { relaxed: true }],
        },
        Object.fromEntries(
            (isAll ? [] : ['no-inline-style', 'prefer-button', 'prefer-native-element']).map((rule) => [rule, 'off']),
        ),
        Object.fromEntries(rulesOff('site/html-validate').map((rule) => [rule, 'off'])),
    ),
};
recordRules(document);
%><%~ json(document) %>
