    "override": [
        {
            "paths": ["**"],
            "categories": ["variables", "parameters"],
            "reason": "An underscore marks a discarded binding.",
            "allowed_names": ["_"]
        },
        {
            "paths": ["**/.githooks/**", "**/.gspot/hooks/**", "**/.husky/**", "**/hooks/**"],
            "categories": ["files"],
            "reason": "git names its hooks.",
            "allowed_names": [
                "pre-commit",
                "pre-push",
                "commit-msg",
                "post-checkout",
                "post-merge",
                "pre-rebase",
                "prepare-commit-msg"
            ]
        },
        {
            "paths": ["**/e2e/**"],
            "categories": ["folders", "files"],
            "allow_digits": true,
            "reason": "The folder name e2e holds a digit."
        },
        {
            "paths": ["**/migrations/**"],
            "categories": ["folders", "files"],
            "allow_digits": true,
            "reason": "Migration tools name their folders and files with timestamps."
        }
    ],
    "path_containers": [
        {
            "open": "__",
            "close": "__",
            "category": "folders"
        },
        {
            "open": "[",
            "close": "]",
            "category": "path_parameters"
        },
        {
            "open": "(",
            "close": ")",
            "category": "folders"
        },
        {
            "open": "@",
            "close": "",
            "category": "folders"
        },
        {
            "open": "_",
            "close": "",
            "category": "folders"
        }
    ],
