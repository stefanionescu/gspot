    "paths": [
        {
            "paths": ["**"],
            "categories": ["variables", "parameters"],
            "names": ["_", "i", "j", "k", "x", "y", "n"],
            "reason": "Loop and lambda positions take single letters.",
            "skip": true
        },
        {
            "paths": ["**/__init__.py", "**/__main__.py"],
            "categories": ["files"],
            "names": ["__init__", "__main__"],
            "reason": "Python names these files.",
            "skip": true
        },
        {
            "paths": ["**"],
            "categories": ["directories"],
            "names": [
                ".githooks",
                ".mise",
                ".github",
                ".gspot",
                ".vscode",
                ".claude",
                "node_modules",
                "__pycache__",
                "__tests__",
                "__mocks__"
            ],
            "reason": "Tools name these directories.",
            "skip": true
        },
        {
            "paths": ["**"],
            "languages": ["python", "bash"],
            "categories": ["functions", "variables", "constants", "methods", "attributes"],
            "ignored_prefix": "^_+"
        },
        {
            "paths": ["**"],
            "languages": ["typescript", "javascript"],
            "categories": ["parameters", "variables"],
            "ignored_prefix": "^_+"
        },
        {
            "paths": ["**/.githooks/**", "**/.gspot/hooks/**", "**/.husky/**", "**/hooks/**"],
            "categories": ["files"],
            "names": [
                "pre-commit",
                "pre-push",
                "commit-msg",
                "post-checkout",
                "post-merge",
                "pre-rebase",
                "prepare-commit-msg"
            ],
            "reason": "git names its hooks.",
            "skip": true
        },
        {
            "paths": ["**/e2e/**"],
            "categories": ["directories", "files"],
            "allow_digits": true
        },
        {
            "paths": ["**/migrations/**"],
            "categories": ["files"],
            "allow_digits": true
        },
        {
            "paths": ["**/.mise/tasks/**", "**/scripts/steps/**"],
            "categories": ["files"],
            "ignored_prefix": "^\\d{2}-"
        },
        {
            "paths": ["**"],
            "categories": ["directories", "files"],
            "names": ["i18n", "I18N", "l10n", "L10N", "a11y", "A11Y"],
            "reason": "Numeronyms are words.",
            "skip": true
        },
        {
            "paths": ["**/ADVANCED.md"],
            "categories": ["files"],
            "names": ["ADVANCED"],
            "reason": "The docs template names the advanced guide.",
            "skip": true
        },
        {
            "paths": ["**/test_*.py", "**/*_test.py", "**/tests/**/*.py", "**/conftest.py"],
            "languages": ["python"],
            "categories": ["functions", "methods"],
            "ignored_prefix": "^test_",
            "reason": "The test runner finds a test by this prefix."
        }
    ]
}
