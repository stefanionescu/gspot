{
    "version": 1,
    "matching": {
        "whole_parts": true,
        "case_insensitive": true
    },
    "ban_digits": true,
    "ban_repeats": true,
    "groups": {
        "containers": {
            "removable": true,
            "terms": [
                "core",
                "common",
                "generic",
                "misc",
                "stuff",
                "thing",
                "things",
                "details",
                "info",
                "object",
                "taxonomy",
                "tmp",
                "temp"
            ]
        },
        "roles": {
            "removable": true,
            "terms": [
                "helper",
                "helpers",
                "util",
                "utils",
                "manager",
                "handler",
                "processor",
                "wrapper",
                "shim",
                "shims",
                "support"
            ]
        },
        "marketing": {
            "removable": false,
            "terms": [
                "advanced",
                "enhanced",
                "improved",
                "intelligent",
                "smart",
                "modern",
                "robust",
                "seamless",
                "ultimate",
                "comprehensive",
                "optimized",
                "reusable",
                "custom",
                "final",
                "latest",
                "old",
                "new",
                "legacy",
                "plus",
                "combined"
            ]
        },
        "defensive": {
            "removable": false,
            "terms": [
                "ensure",
                "maybe",
                "likely",
                "should",
                "if needed",
                "ifneeded",
                "if available",
                "ifavailable",
                "if changed",
                "ifchanged",
                "if possible",
                "ifpossible",
                "or throw",
                "orthrow",
                "waitfor",
                "with retries",
                "transient",
                "belt and suspenders",
                "fallback",
                "load bearing",
                "load-bearing",
                "loadbearing"
            ]
        },
        "conjunctions": {
            "removable": true,
            "terms": ["and", "or", "with", "when", "what", "whatever", "once", "plus"]
        },
        "tests": {
            "removable": true,
            "terms": [
                "test case",
                "testcase",
                "under test",
                "undertest",
                "edge case",
                "edge cases",
                "snapshot",
                "snapshots",
                "actual"
            ]
        }
    },
    "reserved": [
        {
            "term": "data",
            "uses": ["API success envelope field"]
        },
        {
            "term": "message",
            "uses": ["API client message field"]
        },
        {
            "term": "id",
            "uses": ["identifier word"]
        },
        {
            "term": "config",
            "uses": [
                "configuration directory",
                "configuration file stem",
                "configuration variable",
                "configuration property"
            ]
        },
        {
            "term": "values",
            "uses": ["SQL VALUES clause"]
        }
    ],
    "languages": {
        "typescript": {
            "max_chars": 35,
            "max_words": 4,
            "acronyms": "word",
            "categories": {
                "files": {
                    "case": ["kebab"]
                },
                "directories": {
                    "case": ["kebab"]
                },
                "types": {
                    "case": ["pascal"]
                },
                "classes": {
                    "case": ["pascal"]
                },
                "functions": {
                    "case": ["camel"]
                },
                "methods": {
                    "case": ["camel"]
                },
                "parameters": {
                    "case": ["camel"]
                },
                "variables": {
                    "case": ["camel", "upper-snake"]
                },
                "constants": {
                    "case": ["camel", "upper-snake"]
                },
                "properties": {
                    "case": ["camel"]
                },
                "routes": {
                    "case": ["kebab"]
                },
                "path_parameters": {
                    "case": ["camel"]
                },
                "operation_ids": {
                    "case": ["camel"]
                },
                "enum_cases": {
                    "case": ["pascal", "camel"]
                }
            }
        },
        "javascript": {
            "max_chars": 35,
            "max_words": 4,
            "acronyms": "word",
            "categories": {
                "files": {
                    "case": ["kebab"]
                },
                "directories": {
                    "case": ["kebab"]
                },
                "types": {
                    "case": ["pascal"]
                },
                "classes": {
                    "case": ["pascal"]
                },
                "functions": {
                    "case": ["camel"]
                },
                "methods": {
                    "case": ["camel"]
                },
                "parameters": {
                    "case": ["camel"]
                },
                "variables": {
                    "case": ["camel", "upper-snake"]
                },
                "constants": {
                    "case": ["camel", "upper-snake"]
                },
                "properties": {
                    "case": ["camel", "upper-snake"]
                },
                "routes": {
                    "case": ["kebab"]
                }
            }
        },
        "python": {
            "max_chars": 35,
            "max_words": 4,
            "acronyms": "lower",
            "categories": {
                "files": {
                    "case": ["snake"]
                },
                "directories": {
                    "case": ["snake"]
                },
                "modules": {
                    "case": ["snake"]
                },
                "packages": {
                    "case": ["snake"]
                },
                "types": {
                    "case": ["pascal"]
                },
                "type_aliases": {
                    "case": ["pascal"]
                },
                "variables": {
                    "case": ["snake", "upper-snake"]
                },
                "constants": {
                    "case": ["upper-snake"]
                },
                "attributes": {
                    "case": ["snake", "upper-snake"]
                },
                "properties": {
                    "case": ["snake"]
                }
            }
        },
        "swift": {
            "max_chars": 40,
            "max_words": 5,
            "acronyms": "initialism",
            "categories": {
                "files": {
                    "case": ["pascal", "pascal-extension"]
                },
                "directories": {
                    "case": ["pascal"]
                },
                "functions": {
                    "case": ["camel"]
                },
                "methods": {
                    "case": ["camel"]
                }
            }
        },
        "bash": {
            "max_chars": 35,
            "max_words": 4,
            "acronyms": "lower",
            "categories": {
                "files": {
                    "case": ["kebab", "snake"]
                },
                "directories": {
                    "case": ["kebab", "snake"]
                },
                "functions": {
                    "case": ["snake"]
                },
                "variables": {
                    "case": ["snake", "upper-snake"]
                },
                "constants": {
                    "case": ["upper-snake"]
                }
            }
        },
        "sql": {
            "max_chars": 55,
            "max_words": 7,
            "acronyms": "lower",
            "categories": {
                "files": {
                    "case": ["timestamp-snake", "snake"]
                },
                "directories": {
                    "case": ["snake"]
                },
                "functions": {
                    "case": ["snake"]
                },
                "parameters": {
                    "case": ["snake"]
                },
                "schemas": {
                    "case": ["snake"]
                },
                "tables": {
                    "case": ["snake"]
                },
                "columns": {
                    "case": ["snake"]
                },
                "indexes": {
                    "case": ["snake"]
                },
                "triggers": {
                    "case": ["snake"]
                },
                "policies": {
                    "case": ["snake"]
                }
            }
        }
    },
