<%
const document = {
    extends: ['html-validate:recommended'],
    rules: Object.assign(
        {
            'doctype-style': ['error', { style: 'lowercase' }],
            'no-inline-style': 'error',
            'no-raw-characters': 'error',
            'void-style': ['error', { style: 'selfclosing' }],
        },
        Object.fromEntries(
            (isAll ? [] : ['no-inline-style', 'prefer-button', 'prefer-native-element']).map((rule) => [rule, 'off']),
        ),
        Object.fromEntries(rulesOff('html/validate').map((rule) => [rule, 'off'])),
    ),
};
recordRules(document);
%><%~ json(document) %>
