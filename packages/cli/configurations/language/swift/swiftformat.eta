<%
const version = swiftVersion();
const document = {
    options: {
        indent: format.indent_style === 'tab' ? 'tab' : format.indent_width,
        indentcase: false,
        ifdef: 'indent',
        maxwidth: format.print_width,
        wraparguments: 'before-first',
        wrapparameters: 'before-first',
        wrapcollections: 'before-first',
        wrapreturntype: 'preserve',
        wrapconditions: 'preserve',
        closingparen: 'balanced',
        commas: format.trailing_commas === 'none' ? 'never' : format.trailing_commas === 'es5' ? 'collections-only' : 'always',
        nospaceoperators: '...,..<',
        operatorfunc: 'spaced',
        ranges: 'spaced',
        allman: false,
        elseposition: 'same-line',
        guardelse: 'next-line',
        emptybraces: 'no-space',
        trimwhitespace: 'always',
        linebreaks: format.line_ending,
        importgrouping: 'length,alpha',
        self: 'init-only',
        ...(version === undefined ? {} : { swiftversion: version }),
    },
    enable: isAll ? ['blockComments', 'wrapEnumCases'].filter((rule) => !rulesOff('swift/swiftformat').includes(rule)) : [],
    disable: [...new Set([
        ...[
            'trailingClosures',
            'initCoderUnavailable',
            'redundantInternal',
            'redundantPublic',
        ],
        ...rulesOff('swift/swiftformat'),
        ...(isAll
            ? []
            : [
                  'hoistPatternLet',
                  'modifierOrder',
                  'redundantClosure',
                  'redundantExtensionACL',
                  'redundantFileprivate',
                  'redundantGet',
                  'redundantInit',
                  'redundantLet',
                  'redundantLetError',
                  'redundantNilInit',
                  'redundantObjc',
                  'redundantRawValues',
                  'redundantReturn',
                  'strongOutlets',
                  'strongifiedSelf',
                  'typeSugar',
                  'void',
                  'redundantSelf',
                  'wrapEnumCases',
                  'trailingClosures',
                  'andOperator',
                  'anyObjectProtocol',
                  'applicationMain',
                  'assertionFailures',
                  'conditionalAssignment',
                  'consistentSwitchCaseSpacing',
                  'docCommentsBeforeModifiers',
                  'emptyExtensions',
                  'enumNamespaces',
                  'environmentEntry',
                  'extensionAccessControl',
                  'fileHeader',
                  'fileMacro',
                  'genericExtensions',
                  'headerFileName',
                  'hoistAwait',
                  'hoistTry',
                  'modifiersOnSameLine',
                  'noForceTryInTests',
                  'noForceUnwrapInTests',
                  'opaqueGenericParameters',
                  'preferForLoop',
                  'preferKeyPath',
                  'redundantAsync',
                  'redundantEmptyView',
                  'redundantEquatable',
                  'redundantMemberwiseInit',
                  'redundantOptionalBinding',
                  'redundantSendable',
                  'redundantStaticSelf',
                  'redundantSwiftTestingSuite',
                  'redundantThrows',
                  'redundantType',
                  'redundantTypedThrows',
                  'redundantVariable',
                  'redundantViewBuilder',
                  'simplifyGenericConstraints',
                  'sortTypealiases',
                  'swiftTestingTestCaseNames',
                  'wrapFunctionBodies',
                  'wrapPropertyBodies',
                  'wrapSingleLineComments',
                  'yodaConditions',
              ]),
    ])],
    comments: {
        trailingClosures: '# SwiftLint trailing_closure owns closure syntax, so one tool reports it.',
        initCoderUnavailable:
            '# Inserts an availability attribute into UIKit initializers, a behavior change, not a layout one.',
        redundantInternal: '# SwiftLint owns explicit access annotations, so the formatter keeps them.',
    },
};
recordRules(document);
%><% for (const [option, value] of Object.entries(document.options)) { %>--<%= option %> <%= value %>
<% } %>
<% for (const rule of document.enable) { %>--enable <%= rule %>
<% } %>
<% for (const rule of document.disable) { if (document.comments[rule]) { %><%= document.comments[rule] %>
<% } %>--disable <%= rule %>
<% } %>
