<%
const OPT_IN = [
    'missing_docs',
    'explicit_init',
    'fatal_error_message',
    'first_where',
    'last_where',
    'empty_count',
    'empty_string',
    'contains_over_first_not_nil',
    'contains_over_filter_count',
    'contains_over_filter_is_empty',
    'contains_over_range_nil_comparison',
    'direct_return',
    'empty_collection_literal',
    'flatmap_over_map_reduce',
    'untyped_error_in_catch',
    'accessibility_label_for_image',
    'accessibility_trait_for_button',
    'private_swiftui_state',
    'prefer_self_in_static_references',
    'closure_body_length',
    'array_init',
    'sorted_first_last',
    'enum_case_associated_values_count',
    'switch_case_on_newline',
    'async_without_await',
    'convenience_type',
    'fallthrough',
    'force_unwrapping',
    'function_default_parameter_at_end',
    'implicitly_unwrapped_optional',
    'joined_default_parameter',
    'legacy_multiple',
    'legacy_random',
    'literal_expression_end_indentation',
    'lower_acl_than_parent',
    'overridden_super_call',
    'prefer_zero_over_explicit_init',
    'private_action',
    'private_outlet',
    'prohibited_super_call',
    'raw_value_for_camel_cased_codable_enum',
    'reduce_into',
    'redundant_nil_coalescing',
    'redundant_type_annotation',
    'static_operator',
    'toggle_bool',
    'trailing_closure',
    'unavailable_function',
    'unowned_variable_capture',
    'yoda_condition',
    'balanced_xctest_lifecycle',
    'empty_xctest_method',
    'final_test_case',
    'test_case_accessibility',
    'xct_specific_matcher',
    'unhandled_throwing_task',
    'discarded_notification_center_observer',
    'identical_operands',
    'return_value_from_void_function',
    'weak_delegate',
    'superfluous_else',
    'pattern_matching_keywords',
    'optional_enum_case_matching',
    'shorthand_optional_binding',
    'self_binding',
    'prefer_key_path',
    'local_doc_comment',
    'period_spacing',
    'prefer_self_type_over_type_of_self',
    'unneeded_override',
    'no_magic_numbers',
    'type_contents_order',
    'file_types_order',
    'no_empty_block',
    'explicit_acl',
    'explicit_top_level_acl',
    'private_over_fileprivate',
    'file_name_no_space',
    'discouraged_optional_boolean',
    'discouraged_optional_collection',
];
const ANALYZER = ['capture_variable', 'typesafe_array_init', 'unused_import'];
const pair = (count) => ({ warning: count, error: count });
const off = [
    ...rulesOff('swift/swiftlint'),
    ...(isAll
        ? []
        : [
              'closure_body_length',
              'convenience_type',
              'cyclomatic_complexity',
              'discouraged_direct_init',
              'enum_case_associated_values_count',
              'explicit_acl',
              'explicit_top_level_acl',
              'file_length',
              'file_name_no_space',
              'file_types_order',
              'final_test_case',
              'force_unwrapping',
              'function_body_length',
              'function_default_parameter_at_end',
              'function_parameter_count',
              'identifier_name',
              'implicitly_unwrapped_optional',
              'local_doc_comment',
              'missing_docs',
              'nesting',
              'no_empty_block',
              'no_magic_numbers',
              'period_spacing',
              'private_action',
              'private_outlet',
              'private_over_fileprivate',
              'test_case_accessibility',
              'trailing_closure',
              'type_body_length',
              'type_contents_order',
              'type_name',
              'unavailable_function',
              'unowned_variable_capture',
              'yoda_condition',
          ]),
];
const offSet = new Set(off);
const options = {
    line_length: { ...pair(format.print_width), ignores_urls: true },
    file_length: { ...pair(limit('file_lines', 'swift')), ignore_comment_only_lines: true },
    type_body_length: pair(settings['limits.swift.type_lines']),
    function_parameter_count: { ...pair(limit('function_parameters', 'swift')), ignores_default_parameters: false },
    function_body_length: pair(limit('function_lines', 'swift')),
    cyclomatic_complexity: pair(limit('cyclomatic_complexity', 'swift')),
    closure_body_length: pair(settings['limits.swift.closure_lines']),
    identifier_name: { min_length: 1, max_length: settings['naming.swift.max_chars'] },
    type_name: { min_length: 1, max_length: settings['naming.swift.max_chars'] },
    nesting: { type_level: pair(1), function_level: pair(2) },
    missing_docs: { error: ['open', 'public'] },
    unused_import: { always_keep_imports: settings['tools.swiftlint.keep_imports'] },
    trailing_comma: { mandatory_comma: format.trailing_commas !== 'none' },
};
const document = {
    ...Object.fromEntries(Object.entries(options).filter(([rule]) => !offSet.has(rule))),
    disabled_rules: [
        'trailing_whitespace',
        'opening_brace',
        'statement_position',
        'control_statement',
        'implicit_getter',
        'implicit_optional_initialization',
        ...off.filter((rule) => !OPT_IN.includes(rule) && !ANALYZER.includes(rule)),
    ],
    opt_in_rules: OPT_IN.filter((rule) => !offSet.has(rule)),
    analyzer_rules: ANALYZER.filter((rule) => !offSet.has(rule)),
};
recordRules(document);
%><%~ yaml(document).trimEnd()
    .replace('identifier_name:', '# The case and length of types, variables, parameters, and enum cases; naming/identifiers keeps functions and methods.\nidentifier_name:')
    .replace('disabled_rules:', '# SwiftFormat owns whitespace, brace placement, and statement layout, so one tool reports them.\ndisabled_rules:') %>
<%~ fragments %>
