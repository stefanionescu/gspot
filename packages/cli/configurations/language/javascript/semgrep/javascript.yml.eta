<%
const document = {
    rules: [
        {
            id: 'gspot.javascript.no-dom-html-sinks',
            'pattern-either': [
                {
                    pattern: '$ELEMENT.innerHTML = $VALUE',
                },
                {
                    pattern: '$ELEMENT.outerHTML = $VALUE',
                },
                {
                    pattern: '$ELEMENT.insertAdjacentHTML($POSITION, $VALUE)',
                },
                {
                    pattern: 'document.write($VALUE)',
                },
            ],
            message: 'DOM XSS risk. Use textContent, DOM node creation, or trusted static markup.',
            languages: ['javascript', 'typescript'],
            severity: 'ERROR',
        },
        {
            id: 'gspot.javascript.no-eval',
            'pattern-either': [
                {
                    pattern: 'eval(...)',
                },
                {
                    pattern: 'new Function(...)',
                },
                {
                    pattern: 'setTimeout("...", ...)',
                },
            ],
            message:
                'Code injection risk - eval(), new Function(), and string setTimeout() allow arbitrary code execution. Use safer alternatives.\n',
            languages: ['typescript', 'javascript'],
            severity: 'ERROR',
            metadata: {
                cwe: ['CWE-94'],
                category: 'security',
            },
        },
        {
            id: 'gspot.javascript.ssrf-web-request-user-input',
            patterns: [
                {
                    'pattern-either': [
                        {
                            pattern: '$HTTP(req.body.$VALUE, ...)',
                        },
                        {
                            pattern: '$HTTP(req.query.$VALUE, ...)',
                        },
                        {
                            pattern: '$HTTP(req.params.$VALUE, ...)',
                        },
                        { pattern: '$HTTP($URL.searchParams.get(...), ...)' },
                    ],
                },
                {
                    'metavariable-regex': {
                        metavariable: '$HTTP',
                        regex: '^f[e]tch$',
                    },
                },
            ],
            message:
                'SSRF risk - web request called with a URL from user input. Validate and allowlist target hosts.\n',
            languages: ['typescript', 'javascript'],
            severity: 'ERROR',
            metadata: {
                cwe: ['CWE-918'],
                category: 'security',
            },
        },
        {
            id: 'gspot.javascript.no-secret-in-log',
            patterns: [
                {
                    'pattern-either': [
                        { pattern: '$LOGGER.$LEVEL(process.env.$VAR)' },
                        { pattern: '$LOGGER.$LEVEL(Deno.env.get($VAR))' },
                    ],
                },
                {
                    'metavariable-regex': {
                        metavariable: '$LEVEL',
                        regex: '^(log|trace|debug|info|warn|error|fatal)$',
                    },
                },
                {
                    'metavariable-regex': {
                        metavariable: '$VAR',
                        regex: '.*(KEY|SECRET|PASSWORD|TOKEN|CREDENTIAL).*',
                    },
                },
            ],
            message: 'Sensitive environment variable logged. Remove or mask before logging.\n',
            languages: ['typescript', 'javascript'],
            severity: 'ERROR',
            metadata: {
                cwe: ['CWE-532'],
                category: 'security',
            },
        },
        ...(scopeDependencies.includes('jsonwebtoken')
            ? [
                  {
                      id: 'gspot.javascript.jwt-no-algorithm-none',
                      patterns: [
                          {
                              pattern: 'jwt.verify($TOKEN, $SECRET)',
                          },
                          {
                              'pattern-not': 'jwt.verify($TOKEN, $SECRET, {algorithms: ...})\n',
                          },
                      ],
                      message:
                          'Require the expected JWT signing algorithms when verifying a token. Pass an algorithms option that matches the signing contract.',
                      languages: ['typescript', 'javascript'],
                      severity: 'ERROR',
                      metadata: {
                          cwe: ['CWE-327'],
                          category: 'security',
                      },
                  },
                  {
                      id: 'gspot.javascript.jwt-no-decode-without-verify',
                      pattern: 'jwt.decode(...)',
                      message: 'jwt.decode() does not verify signatures. Use jwt.verify() instead.\n',
                      languages: ['typescript', 'javascript'],
                      severity: 'ERROR',
                      metadata: {
                          cwe: ['CWE-345'],
                          category: 'security',
                      },
                  },
              ]
            : []),
        ...(isAll
            ? []
            : [
                  {
                      id: 'gspot.javascript.no-interpolated-exec',
                      pattern: 'execSync(`...${$VAR}...`)',
                      message:
                          'Template literal interpolation in execSync() is a command injection vector. Use execFileSync() with an argument array instead.\n',
                      languages: ['typescript', 'javascript'],
                      severity: 'ERROR',
                      metadata: {
                          cwe: ['CWE-78'],
                          category: 'security',
                      },
                  },
              ]),
    ],
};
recordRules(document);
%><%~ yaml(document).trimEnd() %>
