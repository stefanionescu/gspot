<%
const extras = verbatim('shellcheck') ?? {};
const document = {
    options: [
        ['source-path', 'SCRIPTDIR'],
        ['external-sources', 'true'],
        ...Object.entries(extras),
    ],
    enable: [
        ...(isAll
            ? [
                  'add-default-case',
                  'avoid-negated-conditions',
                  'avoid-nullary-conditions',
                  'check-extra-masked-returns',
                  'check-set-e-suppressed',
                  'check-unassigned-uppercase',
                  'deprecate-which',
                  'quote-safe-variables',
                  'require-double-brackets',
                  'require-variable-braces',
                  'useless-use-of-cat',
              ]
            : ['check-extra-masked-returns', 'check-set-e-suppressed', 'check-unassigned-uppercase']),
    ],
    disable: rulesOff('bash/shellcheck'),
};
recordRules(document);
%><% for (const [key, value] of document.options) { %><%= key %>=<%= value %>
<% } %>enable=<%= document.enable.join(',') %>
<% if (document.disable.length > 0) { %>disable=<%= document.disable.join(',') %>
<% } %>
