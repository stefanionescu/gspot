shell=bash
source-path=SCRIPTDIR
external-sources=true
<% if (isAll) { %>enable=add-default-case,avoid-negated-conditions,avoid-nullary-conditions,check-extra-masked-returns,check-set-e-suppressed,check-unassigned-uppercase,deprecate-which,quote-safe-variables,require-double-brackets,require-variable-braces,useless-use-of-cat
<% } else { %>enable=check-extra-masked-returns,check-set-e-suppressed,check-unassigned-uppercase
<% } %>
<% const off = rulesOff('bash/shellcheck'); if (off.length > 0) { %>disable=<%= off.join(',') %>
<% } %><% const extras = extra('shellcheck'); if (extras) { for (const [key, value] of Object.entries(extras)) { if (key !== 'reason') { %><%= key %>=<%= value %>
<% } } } %>
