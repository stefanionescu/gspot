<%
const off = rulesOff('css/stylelint');
const allRules = [
    'no-descending-specificity', 'container-name-pattern', 'custom-media-pattern',
    'custom-property-pattern', 'declaration-block-no-redundant-longhand-properties',
    'keyframes-name-pattern', 'layer-name-pattern', 'number-max-precision',
    'selector-class-pattern', 'selector-id-pattern', 'selector-not-notation',
];
const activeRules = new Set([...stylelintRuleNames, 'function-no-unknown'].filter((rule) => isAll || !allRules.includes(rule)));
const chosen = Object.fromEntries(Object.entries(settings['tools.stylelint.rules']).filter(([rule]) => activeRules.has(rule)));
const tailwindAtRules = scopeDependencies.includes('tailwindcss')
    ? ['tailwind', 'apply', 'layer', 'theme', 'utility', 'variant', 'custom-variant', 'source', 'plugin', 'config', 'reference']
    : [];
const componentOverrides = fragmentParts.map((part) => JSON.parse(part)).map((override) => ({
    ...override,
    rules: Object.fromEntries(Object.entries(override.rules).filter(([rule]) => !off.includes(rule) && chosen[rule] === undefined)),
}));
const tailwindFunctions = scopeDependencies.includes('tailwindcss') ? ['theme'] : [];
const document = {
    extends: 'stylelint-config-standard',
    rules: Object.assign(
        {
            'no-descending-specificity': true,
            'at-rule-no-unknown': tailwindAtRules.length > 0 ? [true, { ignoreAtRules: tailwindAtRules }] : true,
            'function-no-unknown': tailwindFunctions.length > 0 ? [true, { ignoreFunctions: tailwindFunctions }] : true,
            'declaration-property-value-no-unknown': tailwindFunctions.length > 0
                ? [true, { ignoreProperties: { '/.*/': ['/\\btheme\\(/'] } }]
                : true,
            'import-notation': 'string',
        },
        Object.fromEntries((isAll ? [] : allRules).map((rule) => [rule, null])),
        chosen,
        Object.fromEntries(off.map((rule) => [rule, null])),
    ),
    overrides: componentOverrides,
};
recordRules(document);
%><%~ json(document) %>
