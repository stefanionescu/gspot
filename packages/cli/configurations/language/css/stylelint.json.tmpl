<% const off = rulesOff('css/stylelint'); const chosen = settings['tools.stylelint.rules']; const ignoreAtRules = settings['tools.stylelint.ignore_at_rules']; const componentRules = Object.fromEntries(Object.entries({
    "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["deep", "global", "slotted"] }],
    "function-no-unknown": [true, { "ignoreFunctions": ["theme", "v-bind"] }]
}).filter(([rule]) => !off.includes(rule) && chosen[rule] === undefined)); %>
{
    "extends": "stylelint-config-standard",
    "ignoreFiles": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/.gspot/**"],
    "rules": <%= json(Object.assign({
        "no-descending-specificity": true,
        "at-rule-no-unknown": ignoreAtRules.length > 0 ? [true, { "ignoreAtRules": ignoreAtRules }] : true,
        "function-no-unknown": [true, { "ignoreFunctions": ["theme"] }],
        "import-notation": "string",
        "property-no-vendor-prefix": [true, { "ignoreProperties": ["-webkit-text-size-adjust", "-webkit-backdrop-filter"] }]
    }, chosen, Object.fromEntries(off.map((rule) => [rule, null])))) %>,
    "overrides": [
        {
            "files": ["*.vue", "*.svelte"],
            "customSyntax": "postcss-html",
            "rules": <%= json(componentRules) %>
        }
    ]
}
