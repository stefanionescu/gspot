{
    "typeCheckingMode": "<%= isAll ? 'all' : 'recommended' %>",
<% if (pythonVenv !== undefined) { -%>
    "venvPath": <%~ json(pythonScopePath) %>,
    "venv": <%~ json(pythonVenv) %>,
<% } -%>
    "strictParameterNoneValue": false,
    "enableTypeIgnoreComments": true,
    "deprecateTypingAliases": false,
    "failOnWarnings": false,
    "reportUnusedImport": "none",
    "reportUnusedVariable": "none",
    "reportRedeclaration": "none",
    "reportPrivateUsage": "none",
    "reportSelfClsParameterName": "none",
    "reportUndefinedVariable": "none",
    "reportIgnoreCommentWithoutRule": "none",
<% if (!isAll) { -%>
    "reportPropertyTypeMismatch": "error",
    "reportMissingTypeStubs": "none",
    "reportImportCycles": "none",
    "reportUnusedClass": "error",
    "reportUnusedFunction": "error",
    "reportDuplicateImport": "error",
    "reportWildcardImportFromLibrary": "none",
    "reportUntypedFunctionDecorator": "error",
    "reportUntypedClassDecorator": "error",
    "reportUntypedBaseClass": "error",
    "reportUntypedNamedTuple": "error",
    "reportTypeCommentUsage": "none",
    "reportPrivateImportUsage": "none",
    "reportDeprecated": "error",
    "reportMissingSuperCall": "none",
    "reportUnknownParameterType": "error",
    "reportUnknownArgumentType": "error",
    "reportUnknownLambdaType": "error",
    "reportUnknownVariableType": "error",
    "reportUnknownMemberType": "error",
    "reportMissingParameterType": "none",
    "reportMissingTypeArgument": "none",
    "reportInvalidTypeVarUse": "error",
    "reportCallInDefaultInitializer": "none",
    "reportUnnecessaryIsInstance": "error",
    "reportUnnecessaryCast": "error",
    "reportUnnecessaryComparison": "error",
    "reportUnnecessaryContains": "error",
    "reportImplicitStringConcatenation": "none",
    "reportInvalidStubStatement": "error",
    "reportIncompleteStub": "error",
    "reportUnsupportedDunderAll": "error",
    "reportUnusedCallResult": "none",
    "reportUnusedCoroutine": "error",
    "reportUnusedExpression": "error",
    "reportUnnecessaryTypeIgnoreComment": "error",
    "reportMatchNotExhaustive": "error",
    "reportImplicitOverride": "none",
    "reportUnreachable": "error",
    "reportAny": "none",
    "reportExplicitAny": "none",
    "reportPrivateLocalImportUsage": "none",
    "reportImplicitRelativeImport": "none",
    "reportUnusedParameter": "none",
    "reportUnannotatedClassAttribute": "none",
    "reportIncompatibleUnannotatedOverride": "error",
    "reportInvalidAbstractMethod": "error",
    "reportSelfClsDefault": "error",
    "reportEmptyAbstractUsage": "error",
<% } -%>
    "include": [<%~ json(pythonScopePath) %>],
    "extraPaths": [<%~ json(pythonScopePath) %>],
    "exclude": <%~ json(pythonExcludes('python/basedpyright')) %>
}
