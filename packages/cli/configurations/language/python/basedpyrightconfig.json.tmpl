<% const root = ['..', '..', ...scope.split('/').filter((part) => part !== '').map(() => '..')].join('/'); const project = scope === '' ? root : `${root}/${scope}`; -%>
{
    "typeCheckingMode": "<%= isAll ? 'all' : 'standard' %>",
<% if (isAll) { %>    "reportPrivateUsage": "error",
<% } %>
    "include": [<%~ json(project) %>],
    "extraPaths": [<%~ json(project) %>],
    "exclude": <%~ json([".venv", "__pycache__", "node_modules", ".gspot", "build", "dist"].map((name) => `${project}/**/${name}`).concat((settings['tools.basedpyright.exclude'] ?? []).flatMap((entry) => (entry.paths ?? []).map((path) => `${root}/${path}`)))) %>
}
