<% const presets = eslintPresets('vue'); const typed = configurations.includes('typescript'); for (const [index, { parser, ...block }] of presets.recommended.blocks.entries()) { %>
<%~ eslintModule.block({ ...block, ...(block.rules === undefined ? {} : { rules: eslintErrorRules(block.rules) }) }, `...vuePlugin.configs['flat/recommended'][${index}]`) %>,
<% } for (const [index, { parser, ...block }] of presets.accessibility.blocks.entries()) { %>
<%~ eslintModule.block({ ...block, files: ['**/*.vue'] }, `...vueAccessibility.configs['flat/recommended'][${index}]`) %>,
<% } %>
<%~ eslintModule.block({ files: ['**/*.vue'], rules: { ...(isAll ? { ...(typed ? { 'vue/define-props-declaration': 'error', 'vue/define-emits-declaration': 'error' } : {}), 'vue/component-api-style': ['error', ['script-setup']], 'vue/no-useless-v-bind': 'error', 'vue/prefer-true-attribute-shorthand': 'error' } : {}), 'vue/no-unused-refs': 'error', 'vue/require-typed-ref': 'error', 'vue/html-button-has-type': 'error', 'vue/no-template-target-blank': 'error' } }, `languageOptions: { parser: vueParser, parserOptions: { ${typed ? 'parser: { ts: tseslint.parser, typescript: tseslint.parser },' : ''} extraFileExtensions: ['.vue'], sourceType: 'module' } }`) %>,
<% if (scopeDependencies.some((name) => name.startsWith('@testing-library/'))) { %>
<%~ eslintModule.block({ files: eslintFiles.tests, rules: eslintErrorRules(presets.testing.blocks[0].rules) }, "plugins: { 'testing-library': testingLibrary }") %>,

<% } %>
