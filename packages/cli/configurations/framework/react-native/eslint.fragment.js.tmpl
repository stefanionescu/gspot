<% for (const selected of configurationScopes('react-native')) { const inScope = selected.path === '' ? '**/*' : `${selected.path}/**/*`; %>
    {
        files: CODE.map((pattern) => [<%= json(inScope, 0) %>, pattern]),
        plugins: { expo: expoPlugin, '@react-native': reactNativePlatform, 'react-native': reactNative },
        rules: {
            // The bundler replaces process.env.EXPO_PUBLIC_NAME where it is written out in full, and nowhere else.
            'expo/no-env-var-destructuring': 'error',
            'expo/no-dynamic-env-var': 'error',
            'expo/use-dom-exports': 'error',
            'expo/prefer-box-shadow': 'error',
            '@react-native/platform-colors': 'error',
            '@react-native/no-deep-imports': 'error',
            'react-native/no-unused-styles': 'error',
            'react-native/no-raw-text': 'error',
            'react-native/no-single-element-style-arrays': 'error',
            'react-native/split-platform-components': 'error',
<% if (isAll) { %>            'react-native/no-inline-styles': 'error',
            'react-native/no-color-literals': 'error',
<% } %>            // A native view tree holds no DOM element, and every jsx-a11y rule reads DOM elements.
            ...Object.fromEntries(Object.keys(accessibility.rules).map((rule) => [`jsx-a11y/${rule}`, 'off'])),
        },
    },
<% } %>
