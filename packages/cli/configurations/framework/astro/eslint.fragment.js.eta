import astroPlugin from 'eslint-plugin-astro';
<% const presets = eslintPresets('astro'); for (const [name, source] of [['recommended', 'flat/recommended'], ['accessibility', 'flat/jsx-a11y-recommended']]) { for (const [index, { parser, ...block }] of presets[name].blocks.entries()) { %>
<%~ eslintModule.block({ ...block, files: block.files ?? ['**/*.astro'], ...(block.rules === undefined ? {} : { rules: eslintErrorRules(block.rules) }) }, `...astroPlugin.configs[${json(source)}][${index}]`) %>,
<% } } %>
<%~ eslintModule.block({ files: ['**/*.astro'], rules: { 'astro/no-set-html-directive': 'error', 'astro/no-exports-from-components': 'error', 'astro/no-prerender-export-outside-pages': 'error', ...(isAll ? { 'astro/no-unused-css-selector': 'error', 'astro/prefer-class-list-directive': 'error', 'astro/prefer-object-class-list': 'error', 'astro/prefer-split-class-list': 'error' } : {}) } }, 'languageOptions: { parserOptions: { tsconfigRootDir: root } }') %>,
<% if (configurations.includes('typescript')) { %>
<%~ eslintModule.block({ files: ['**/*.astro'], rules: { '@typescript-eslint/no-unsafe-return': 'off' } }, "processor: 'astro/client-side-ts', languageOptions: { parserOptions: { parser: tseslint.parser, projectService: false, project: true } }") %>,
<% const { parser, ...untyped } = eslintPresets('typescript').untyped.blocks[0]; %>
<%~ eslintModule.block({ files: ['**/*.astro/*.ts', '**/*.astro/*.js'], ...untyped }, '...tseslint.configs.disableTypeChecked') %>,
<% } %>
