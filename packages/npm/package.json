{
    "name": "gspot",
    "version": "0.1.0",
    "description": "gspot configures linters, runs checks, and generates instructions for coding agents from one repository configuration",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stefanionescu/gspot.git",
        "directory": "packages/npm"
    },
    "bin": {
        "gspot": "gspot.js"
    },
    "files": [
        "targets.json"
    ],
    "optionalDependencies": {
        "gspot-darwin-arm64": "0.1.0",
        "gspot-darwin-x64": "0.1.0",
        "gspot-linux-arm64": "0.1.0",
        "gspot-linux-arm64-musl": "0.1.0",
        "gspot-linux-x64": "0.1.0",
        "gspot-linux-x64-musl": "0.1.0",
        "gspot-win32-x64": "0.1.0"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "detect-libc": "2.1.2"
    },
    "type": "commonjs",
    "sideEffects": true,
    "author": "Stefan Ionescu"
}
