{
    "name": "@gspothq/eslint-plugin",
    "version": "0.1.0",
    "publishConfig": {
        "access": "public"
    },
    "description": "ESLint rules for private environment reads, duplicate exports, trivial code, and file organization in JavaScript and TypeScript.",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stefanionescu/gspot.git",
        "directory": "packages/eslint-plugin"
    },
    "type": "module",
    "main": "./dist/plugin.cjs",
    "types": "./dist/plugin.d.ts",
    "exports": {
        ".": {
            "types": "./dist/plugin.d.ts",
            "import": "./dist/plugin.js",
            "require": "./dist/plugin.cjs"
        }
    },
    "imports": {
        "#plugin/*": "./src/*",
        "#plugin-package": "./package.json"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@typescript-eslint/typescript-estree": "8.70.0",
        "@typescript-eslint/utils": "8.70.0",
        "picomatch": "4.0.7"
    },
    "devDependencies": {
        "@types/picomatch": "4.0.2",
        "eslint": "9.39.5",
        "typescript": "5.9.3"
    },
    "peerDependencies": {
        "eslint": ">=9.38.0",
        "typescript": ">=4.8.4 <6.1.0"
    },
    "sideEffects": false,
    "author": "Stefan Ionescu",
    "engines": {
        "node": ">=22"
    }
}
