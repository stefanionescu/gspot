{
    "name": "@gspothq/eslint-plugin",
    "version": "0.2.2",
    "publishConfig": {
        "access": "public"
    },
    "description": "ESLint rules for code that AI coding agents often write.",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stefanionescu/gspot.git",
        "directory": "packages/eslint-plugin"
    },
    "type": "module",
