{
    "name": "@gspot/eslint-plugin",
    "version": "0.1.0",
    "description": "The structural ESLint rules gspot ships for JavaScript and TypeScript: wrappers, barrels, lone files, import layout and direction, private-first order, types placement.",
    "license": "Apache-2.0",
    "repository": "github:stefanionescu/gspot",
    "type": "module",
    "main": "./dist/plugin.cjs",
    "module": "./dist/plugin.js",
    "types": "./dist/plugin.d.ts",
    "exports": {
        ".": {
            "types": "./dist/plugin.d.ts",
            "import": "./dist/plugin.js",
            "require": "./dist/plugin.cjs"
        }
    },
    "imports": {
        "#plugin/*": "./src/*",
        "#plugin-types/*": "./types/*",
        "#plugin-tests/*": "./tests/*",
        "#plugin-package": "./package.json"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@typescript-eslint/utils": "8.70.0",
        "picomatch": "4.0.7"
    },
    "devDependencies": {
        "@typescript-eslint/parser": "8.70.0",
        "@typescript-eslint/rule-tester": "8.70.0",
        "eslint": "10.10.0",
        "typescript": "5.9.3",
        "@types/picomatch": "4.0.2"
    },
    "peerDependencies": {
        "eslint": ">=9.38.0"
    }
}
