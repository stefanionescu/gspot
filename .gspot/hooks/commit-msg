#!/bin/sh
# Generated by gspot 0.1.0 from gspot.toml. Regenerate: gspot apply.
case "$1" in /*|[A-Za-z]:*) message=$1 ;; *) message="$PWD/$1" ;; esac
if command -v cygpath >/dev/null 2>&1; then message=$(cygpath -w "$message"); fi
set -- "$message"
command -v mise >/dev/null 2>&1 || { echo 'The command that runs gspot is not installed. Install gspot, then run: gspot install' >&2; exit 2; }
GSPOT_HOOK=commit-msg exec mise exec -- gspot check --stage message --message-file "$1"
