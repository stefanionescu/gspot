#!/bin/sh
case "$1" in /*|[A-Za-z]:*) message=$1 ;; *) message="$PWD/$1" ;; esac
if command -v cygpath >/dev/null 2>&1; then message=$(cygpath -w "$message"); fi
set -- "$message"
command -v mise >/dev/null 2>&1 || { echo 'mise is not installed. Install mise, then run: mise install. Install gspot with: mise use --pin --tool-option allow_low_downloads=true npm:@gspothq/cli@0.3.7' >&2; exit 2; }
exec mise exec -- gspot check --hook commit-msg -- "$1"
