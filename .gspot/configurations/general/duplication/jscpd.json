{
    "mode": "strict",
    "minLines": 8,
    "minTokens": 40,
    "absolute": true,
    "gitignore": true,
    "ignore": [
        "**/*.md",
        "**/*.mdx",
        "**/build/**",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/*.swp",
        "**/*~",
        "**/.idea/**",
        "**/.vscode/**",
        "**/node_modules/**",
        "**/.env",
        "**/.env.*",
        "**/*.log",
        ".wrangler/**",
        "packages/*/dist/**",
        "packages/cli/grammars/**",
        "docs/dist/**",
        "docs/.astro/**",
        "docs/.wrangler/**",
        "findings/**",
        ".gspot/**",
        "**/eslint.config.mjs",
        "**/.markdownlint.jsonc",
        "**/.editorconfig",
        "**/prettier.config.mjs",
        "**/.prettierignore",
        "docs/.markdownlint.jsonc",
        "docs/.stylelintrc.json",
        "packages/cli/.markdownlint.jsonc",
        "packages/eslint-plugin/.markdownlint.jsonc",
        "packages/cli/configurations/**/eslint-presets.json",
        "packages/cli/configurations/**/*-names.json",
        "docs/worker-configuration.d.ts",
        "docs/cloudflare-env.d.ts",
        "**/bower_components/**",
        "**/bun.lock",
        "**/.env*",
        "tests/suites/integration/checks/language/swift/swiftlint.test.ts",
        "tests/suites/integration/checks/language/css.test.ts",
        "tests/suites/integration/checks/language/sql.test.ts",
        "tests/suites/integration/checks/general/data-files.test.ts",
        "tests/suites/unit/cli/checks/language/python/vulture.test.ts",
        "tests/suites/unit/cli/checks/language/python/deptry.test.ts",
        "tests/suites/unit/cli/checks/language/python/pydoclint.test.ts",
        "tests/suites/unit/cli/checks/framework/nextjs.test.ts",
        "tests/suites/unit/cli/checks/language/bash/unused-functions.test.ts",
        "tests/suites/unit/cli/checks/language/bash/script-layout.test.ts"
    ]
}
