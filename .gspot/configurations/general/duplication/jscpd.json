{
    "mode": "strict",
    "minLines": 8,
    "minTokens": 40,
    "absolute": true,
    "gitignore": true,
    "ignorePattern": [
        "import\\s[^;]*?from\\s*['\"][^'\"]+['\"]\\s*;"
    ],
    "ignore": [
        "**/*.md",
        "**/*.mdx",
        "**/build/**",
        "**/node_modules/**",
        "**/.env",
        "**/.env.*",
        "**/*.log",
        "packages/*/dist/**",
        "packages/cli/grammars/**",
        "docs/dist/**",
        "docs/.astro/**",
        "docs/.wrangler/**",
        "tests/tools/**",
        "findings/**",
        ".gspot/**",
        "eslint.config.mjs",
        ".markdownlint.jsonc",
        ".editorconfig",
        "prettier.config.mjs",
        ".prettierignore",
        "docs/.markdownlint.jsonc",
        "docs/.stylelintrc.json",
        "packages/cli/.markdownlint.jsonc",
        "packages/eslint-plugin/.markdownlint.jsonc",
        "tests/.markdownlint.jsonc",
        "packages/cli/README.md",
        "packages/cli/LICENSE.md",
        "packages/eslint-plugin/LICENSE.md",
        "docs/worker-configuration.d.ts",
        "docs/cloudflare-env.d.ts",
        "**/bower_components/**",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/bun.lock",
        "**/.env*"
    ]
}
