{
    "mode": "strict",
    "minLines": 8,
    "minTokens": 40,
    "absolute": true,
    "gitignore": true,
    "ignorePattern": [
        "import\\s[^;]*?from\\s*['\"][^'\"]+['\"]\\s*;"
    ],
    "ignore": [
        "**/*.md",
        "**/*.mdx",
        "**/build/**",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/*.swp",
        "**/*~",
        "**/.idea/**",
        "**/.vscode/**",
        "**/node_modules/**",
        "**/.env",
        "**/.env.*",
        "**/*.log",
        ".wrangler/**",
        "packages/*/dist/**",
        "packages/cli/grammars/**",
        "docs/dist/**",
        "docs/.astro/**",
        "docs/.wrangler/**",
        "findings/**",
        ".gspot/**",
        "eslint.config.mjs",
        ".markdownlint.jsonc",
        ".editorconfig",
        "prettier.config.mjs",
        ".prettierignore",
        "docs/.markdownlint.jsonc",
        "docs/.stylelintrc.json",
        "packages/cli/.markdownlint.jsonc",
        "packages/eslint-plugin/.markdownlint.jsonc",
        "packages/cli/configurations/**/eslint-presets.json",
        "packages/cli/configurations/**/*-names.json",
        "docs/worker-configuration.d.ts",
        "docs/cloudflare-env.d.ts",
        "**/bower_components/**",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/bun.lock",
        "**/.env*"
    ]
}
