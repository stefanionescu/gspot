{
    "mode": "strict",
    "minLines": 8,
    "minTokens": 40,
    "absolute": true,
    "gitignore": true,
    "ignorePattern": [
        "import\\s[^;]*?from\\s*['\"][^'\"]+['\"]\\s*;",
        "(?:^|\\n)[\\t ]*(?:from[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*[\\w.]+[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*)?import[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*(?:\\([^;)]*\\)|(?:\\\\\\r?\\n|[^;\\r\\n])*)"
    ],
    "ignore": [
        "**/*.md",
        "**/*.mdx",
        "**/build/**",
        ".gspot/**",
        ".gspot-copies/**",
        ".editorconfig",
        ".github/workflows/gspot.yml",
        ".markdownlint.jsonc",
        ".prettierignore",
        ".stylelintrc.yml",
        "eslint.config.mjs",
        "prettier.config.mjs",
        "packages/cli/README.md",
        "tests/setup/sandboxes/test-tools.lock",
        "docs/worker-configuration.d.ts",
        "docs/cloudflare-env.d.ts",
        "**/node_modules/**",
        "**/bower_components/**",
        "**/coverage/**",
        "**/.env",
        "**/.env.*",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/.wrangler/**",
        "**/bun.lock",
        "**/*.log",
        "packages/*/dist/**",
        "docs/dist/**",
        "docs/.astro/**",
        "docs/.wrangler/**"
    ]
}
