{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": [
        "**/build/**",
        "**/node_modules/**",
        "**/.env",
        "**/.env.*",
        "**/*.log",
        "packages/*/dist/**",
        "packages/cli/grammars/**",
        "docs/dist/**",
        "docs/.astro/**",
        "docs/.wrangler/**",
        "tests/tools/**",
        "findings/**",
        ".gspot/**",
        "eslint.config.mjs",
        ".markdownlint.jsonc",
        ".editorconfig",
        "prettier.config.mjs",
        ".prettierignore",
        "docs/.markdownlint.jsonc",
        "docs/.stylelintrc.json",
        "packages/cli/.markdownlint.jsonc",
        "packages/eslint-plugin/.markdownlint.jsonc",
        "tests/.markdownlint.jsonc",
        "packages/cli/README.md",
        "packages/cli/LICENSE.md",
        "packages/eslint-plugin/LICENSE.md",
        "docs/worker-configuration.d.ts",
        "docs/cloudflare-env.d.ts",
        "**/bower_components/**",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/bun.lock",
        "**/.env*"
    ],
    "ignoreDependencies": [
        "@gspothq/cli",
        "@eslint/js",
        "@gspothq/eslint-plugin",
        "ajv",
        "@astrojs/check",
        "@commitlint/cli",
        "eslint",
        "eslint-config-prettier",
        "eslint-import-resolver-typescript",
        "eslint-plugin-astro",
        "eslint-plugin-barrel-files",
        "eslint-plugin-boundaries",
        "eslint-plugin-import-x",
        "eslint-plugin-jsdoc",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-n",
        "eslint-plugin-package-json",
        "eslint-plugin-perfectionist",
        "eslint-plugin-regexp",
        "eslint-plugin-security",
        "eslint-plugin-sonarjs",
        "eslint-plugin-unicorn",
        "eslint-plugin-zod",
        "globals",
        "html-validate",
        "jscpd",
        "knip",
        "license-checker-rseidelsohn",
        "markdownlint-cli2",
        "picomatch",
        "prettier",
        "prettier-plugin-astro",
        "purgecss",
        "stylelint",
        "stylelint-config-standard",
        "syncpack",
        "typescript",
        "typescript-eslint",
        "v8r",
        "wrangler",
        "@socketsecurity/bun-security-scanner"
    ],
    "ignoreBinaries": [
        "actionlint",
        "astro-check",
        "commitlint",
        "editorconfig-checker",
        "eslint",
        "gitleaks",
        "html-validate",
        "jscpd",
        "knip",
        "license-checker-rseidelsohn",
        "lychee",
        "markdownlint-cli2",
        "node",
        "osv-scanner",
        "prettier",
        "purgecss",
        "semgrep",
        "shellcheck",
        "shfmt",
        "stylelint",
        "syncpack",
        "taplo",
        "tsc",
        "typos",
        "v8r",
        "vale",
        "wrangler",
        "yamllint",
        "zizmor",
        "mise"
    ],
    "ignoreExportsUsedInFile": false,
    "workspaces": {
        ".": {
            "entry": [
                "tests/setup/runner/unit.ts",
                "tests/setup/programs/**/*.ts",
                "packages/eslint-plugin/src/plugin.ts",
                "tests/setup/runner/prepare.ts",
                "tests/setup/sandboxes/tool-project.ts",
                "tests/setup/runner/integration.ts",
                "packages/cli/src/checks/framework/site/purgecss-process.ts",
                "packages/cli/configurations/language/javascript/config-files/eslint-functions.ts",
                "packages/cli/src/bin.ts",
                "packages/cli/configurations/language/markdown/config-files/markdownlint-cli2.ts",
                "packages/cli/configurations/framework/site/config-files/purgecss.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ]
        },
        "docs": {
            "entry": [
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ],
            "ignoreDependencies": [
                "satteri"
            ]
        },
        "packages/cli": {
            "entry": [
                "src/checks/framework/site/purgecss-process.ts",
                "configurations/language/javascript/config-files/eslint-functions.ts",
                "src/bin.ts",
                "configurations/language/markdown/config-files/markdownlint-cli2.ts",
                "configurations/framework/site/config-files/purgecss.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ],
            "ignoreDependencies": [
                "tree-sitter-bash",
                "tree-sitter-css",
                "tree-sitter-html",
                "tree-sitter-javascript",
                "tree-sitter-python",
                "tree-sitter-typescript"
            ]
        },
        "packages/eslint-plugin": {
            "entry": [
                "src/plugin.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ],
            "ignoreDependencies": []
        },
        "tests": {
            "entry": [
                "setup/runner/unit.ts",
                "setup/programs/**/*.ts",
                "setup/runner/prepare.ts",
                "setup/sandboxes/tool-project.ts",
                "setup/runner/integration.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ],
            "ignoreDependencies": []
        }
    }
}
