{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": [
        "**/build/**",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/*.swp",
        "**/*~",
        "**/.idea/**",
        "**/.vscode/**",
        "**/node_modules/**",
        "**/.env",
        "**/.env.*",
        "**/*.log",
        ".wrangler/**",
        "packages/*/dist/**",
        "packages/cli/grammars/**",
        "docs/dist/**",
        "docs/.astro/**",
        "docs/.wrangler/**",
        "findings/**",
        ".gspot/**",
        "**/eslint.config.mjs",
        "**/.markdownlint.jsonc",
        "**/.editorconfig",
        "**/prettier.config.mjs",
        "**/.prettierignore",
        "docs/.markdownlint.jsonc",
        "docs/.stylelintrc.json",
        "packages/cli/.markdownlint.jsonc",
        "packages/eslint-plugin/.markdownlint.jsonc",
        "packages/cli/configurations/**/eslint-presets.json",
        "packages/cli/configurations/**/*-names.json",
        "docs/worker-configuration.d.ts",
        "docs/cloudflare-env.d.ts",
        "**/bower_components/**",
        "**/bun.lock",
        "**/.env*"
    ],
    "ignoreDependencies": [
        "@gspothq/cli",
        "@eslint/js",
        "@gspothq/eslint-plugin",
        "ajv",
        "@astrojs/check",
        "@commitlint/cli",
        "eslint",
        "eslint-config-prettier",
        "eslint-import-resolver-typescript",
        "eslint-plugin-astro",
        "eslint-plugin-barrel-files",
        "eslint-plugin-boundaries",
        "eslint-plugin-import-x",
        "eslint-plugin-jsdoc",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-n",
        "eslint-plugin-package-json",
        "eslint-plugin-perfectionist",
        "eslint-plugin-regexp",
        "eslint-plugin-security",
        "eslint-plugin-sonarjs",
        "eslint-plugin-unicorn",
        "eslint-plugin-zod",
        "globals",
        "html-validate",
        "jscpd",
        "knip",
        "license-checker-rseidelsohn",
        "linkinator",
        "markdownlint-cli2",
        "picomatch",
        "prettier",
        "prettier-plugin-astro",
        "purgecss",
        "stylelint",
        "stylelint-config-standard",
        "syncpack",
        "typescript",
        "typescript-eslint",
        "v8r",
        "wrangler",
        "@socketsecurity/bun-security-scanner"
    ],
    "ignoreBinaries": [
        "actionlint",
        "astro-check",
        "commitlint",
        "editorconfig-checker",
        "eslint",
        "gitleaks",
        "html-validate",
        "jscpd",
        "knip",
        "license-checker-rseidelsohn",
        "linkinator",
        "lychee",
        "markdownlint-cli2",
        "node",
        "osv-scanner",
        "prettier",
        "purgecss",
        "semgrep",
        "shellcheck",
        "shfmt",
        "stylelint",
        "syncpack",
        "taplo",
        "trufflehog",
        "tsc",
        "typos",
        "v8r",
        "vale",
        "wrangler",
        "yamllint",
        "zizmor",
        "mise"
    ],
    "ignoreExportsUsedInFile": false,
    "workspaces": {
        ".": {
            "entry": [
                "tests/setup/runner/unit-preload.ts",
                "packages/eslint-plugin/repository.mjs",
                "tests/setup/runner/prepare.ts",
                "tests/setup/runner/integration-preload.ts",
                "packages/cli/src/checks/site/purgecss-process.ts",
                "packages/cli/configurations/language/javascript/config-files/eslint-runtime.mjs",
                "docs/src/route-data.ts",
                "packages/cli/src/bin.ts",
                "packages/cli/configurations/language/markdown/config-files/markdownlint-cli2.mjs",
                "packages/cli/src/configurations/package-copies.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ]
        },
        "docs": {
            "entry": [
                "src/route-data.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ],
            "ignoreDependencies": [
                "@fontsource-variable/geist",
                "@fontsource-variable/geist-mono",
                "satteri"
            ]
        },
        "packages/cli": {
            "entry": [
                "src/checks/site/purgecss-process.ts",
                "configurations/language/javascript/config-files/eslint-runtime.mjs",
                "src/bin.ts",
                "configurations/language/markdown/config-files/markdownlint-cli2.mjs",
                "src/configurations/package-copies.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ],
            "ignoreDependencies": [
                "tree-sitter-bash",
                "tree-sitter-css",
                "tree-sitter-html",
                "tree-sitter-javascript",
                "tree-sitter-python",
                "tree-sitter-typescript"
            ]
        },
        "packages/eslint-plugin": {
            "entry": [
                "repository.mjs",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ],
            "ignoreDependencies": []
        },
        "tests": {
            "entry": [
                "setup/runner/unit-preload.ts",
                "setup/runner/prepare.ts",
                "setup/runner/integration-preload.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ],
            "ignoreDependencies": [
                "@darraghor/eslint-plugin-nestjs-typed",
                "@next/eslint-plugin-next",
                "@react-native/eslint-plugin",
                "@vitest/eslint-plugin",
                "bats",
                "eslint-plugin-drizzle",
                "eslint-plugin-expo",
                "eslint-plugin-i18next",
                "eslint-plugin-jest",
                "eslint-plugin-react",
                "eslint-plugin-react-hooks",
                "eslint-plugin-react-native",
                "eslint-plugin-react-refresh",
                "eslint-plugin-svelte",
                "eslint-plugin-testing-library",
                "eslint-plugin-vue",
                "eslint-plugin-vuejs-accessibility",
                "pnpm",
                "supabase",
                "svelte-eslint-parser",
                "vue-eslint-parser",
                "yarn",
                "@nestjs/common",
                "@nestjs/core",
                "@tanstack/eslint-plugin-query",
                "eslint-plugin-jsx-a11y",
                "reflect-metadata",
                "rxjs",
                "vue"
            ]
        }
    }
}
