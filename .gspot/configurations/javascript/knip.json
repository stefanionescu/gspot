{
    "ignore": [
        "**/build/**",
        ".gspot/**",
        ".gspot-copies/**",
        "prettier.config.mjs",
        "docs/worker-configuration.d.ts",
        "docs/cloudflare-env.d.ts",
        "**/node_modules/**",
        "**/bower_components/**",
        "**/coverage/**",
        "**/.dev.vars.*",
        "**/.wrangler/**",
        "docs/.astro/**",
        "docs/.wrangler/**",
        "docs/dist/**",
        "packages/*/dist/**"
    ],
    "ignoreDependencies": [
        "@gspothq/cli",
        "@emnapi/runtime",
        "@eslint/js",
        "ajv",
        "eslint-config-prettier",
        "eslint-import-resolver-typescript",
        "eslint-plugin-astro",
        "eslint-plugin-boundaries",
        "eslint-plugin-import-x",
        "eslint-plugin-jsdoc",
        "eslint-plugin-jsx-a11y-x",
        "eslint-plugin-n",
        "eslint-plugin-package-json",
        "eslint-plugin-perfectionist",
        "eslint-plugin-regexp",
        "eslint-plugin-security",
        "eslint-plugin-unicorn",
        "eslint-plugin-zod",
        "globals",
        "postcss-html",
        "prettier-plugin-astro",
        "stylelint-config-standard",
        "typescript-eslint",
        "@socketsecurity/bun-security-scanner"
    ],
    "ignoreBinaries": [],
    "workspaces": {
        ".": {
            "entry": [
                "tests/setup/runner/unit.ts",
                "tests/setup/programs/**/*.ts",
                "tests/setup/runner/prepare.ts",
                "tests/setup/sandboxes/test-tools.ts",
                "tests/setup/runner/integration.ts",
                "packages/cli/src/configurations/framework/site/checks/selector-process.ts",
                "packages/cli/src/configurations/language/javascript/files/eslint-functions.ts",
                "packages/cli/src/configurations/language/javascript/files/eslint-fixes.ts",
                "packages/cli/src/configurations/language/javascript/files/eslint-import-cycles.ts",
                "packages/cli/src/bin.ts",
                "packages/cli/src/configurations/language/markdown/files/markdownlint-cli2.ts",
                "packages/cli/src/configurations/framework/site/files/purgecss.ts",
                ".mise/release/changelog.ts",
                ".mise/release/notices.ts",
                ".mise/release/pin-ages.ts",
                "{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}",
                "src/{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/Tests/**",
                "scripts/**",
                "**/*.config.{js,mjs,cjs,ts}",
                "eslint.config.mjs"
            ]
        },
        "docs": {
            "entry": [
                "{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}",
                "src/{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/Tests/**",
                "scripts/**",
                "**/*.config.{js,mjs,cjs,ts}"
            ],
            "ignoreDependencies": []
        },
        "packages/cli": {
            "entry": [
                "src/configurations/framework/site/checks/selector-process.ts",
                "src/configurations/language/javascript/files/eslint-functions.ts",
                "src/configurations/language/javascript/files/eslint-fixes.ts",
                "src/configurations/language/javascript/files/eslint-import-cycles.ts",
                "src/bin.ts",
                "src/configurations/language/markdown/files/markdownlint-cli2.ts",
                "src/configurations/framework/site/files/purgecss.ts",
                "{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}",
                "src/{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/Tests/**",
                "scripts/**",
                "**/*.config.{js,mjs,cjs,ts}"
            ],
            "ignoreDependencies": []
        },
        "packages/eslint-plugin": {
            "entry": [
                "{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}",
                "src/{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/Tests/**",
                "scripts/**",
                "**/*.config.{js,mjs,cjs,ts}"
            ],
            "ignoreDependencies": []
        },
        "tests": {
            "entry": [
                "setup/runner/unit.ts",
                "setup/programs/**/*.ts",
                "setup/runner/prepare.ts",
                "setup/sandboxes/test-tools.ts",
                "setup/runner/integration.ts",
                "{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}",
                "src/{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/Tests/**",
                "scripts/**",
                "**/*.config.{js,mjs,cjs,ts}"
            ],
            "ignoreDependencies": [
                "prettier",
                "stylelint",
                "html-validate"
            ]
        }
    }
}
