{
    "extends": [
        "html-validate:recommended"
    ],
    "rules": {
        "doctype-style": "off",
        "void-style": "off",
        "attr-quotes": "off",
        "attr-case": "off",
        "element-case": "off",
        "no-trailing-whitespace": "off",
        "require-sri": [
            "error",
            {
                "target": "crossorigin"
            }
        ]
    }
}
