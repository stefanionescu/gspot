        "shellcheck",
        "shfmt",
        "stylelint",
        "stylelint-config-standard",
        "syncpack",
        "taplo",
        "trufflehog",
        "tsc",
        "typescript",
        "typescript-eslint",
        "typos",
        "v8r",
        "vale",
        "xmllint",
        "yamllint",
        "zizmor",
        "zsh",
        "vale",
        "git",
        "mise",
        "bunx",
        "npx"
