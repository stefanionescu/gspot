{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": [
        ".gspot/**",
        "eslint.config.mjs",
        "prettier.config.mjs",
        ".markdownlint-cli2.mjs",
        "docs/.markdownlint-cli2.mjs",
        "docs/.stylelintrc.json",
        "packages/cli/.markdownlint-cli2.mjs",
        "packages/eslint-plugin/.markdownlint-cli2.mjs",
        "tests/.markdownlint-cli2.mjs",
        "tests/ruff.toml",
        "tests/pyrightconfig.json",
        "docs/prettier.config.mjs",
        "docs/worker-configuration.d.ts",
        "packages/cli/prettier.config.mjs",
        "packages/eslint-plugin/prettier.config.mjs",
        "tests/prettier.config.mjs",
        "tests/next-env.d.ts"
    ],
    "ignoreDependencies": [
        "@gspothq/cli",
        "@astrojs/check",
        "@commitlint/cli",
        "@darraghor/eslint-plugin-nestjs-typed",
        "@eslint-community/eslint-plugin-eslint-comments",
        "@eslint/js",
        "@gspothq/eslint-plugin",
        "@next/eslint-plugin-next",
        "@vitest/eslint-plugin",
        "editorconfig-checker",
        "eslint",
        "eslint-config-prettier",
        "eslint-import-resolver-typescript",
        "eslint-plugin-astro",
        "eslint-plugin-barrel-files",
        "eslint-plugin-boundaries",
        "eslint-plugin-import-x",
        "eslint-plugin-jest",
        "eslint-plugin-jsdoc",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-n",
        "eslint-plugin-package-json",
        "eslint-plugin-perfectionist",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh",
        "eslint-plugin-regexp",
        "eslint-plugin-security",
        "eslint-plugin-sonarjs",
        "eslint-plugin-svelte",
        "eslint-plugin-unicorn",
        "eslint-plugin-vue",
        "eslint-plugin-vuejs-accessibility",
        "eslint-plugin-zod",
        "globals",
        "html-validate",
        "jscpd",
        "knip",
        "license-checker-rseidelsohn",
        "linkinator",
        "markdownlint-cli2",
        "prettier",
        "prettier-plugin-astro",
        "prettier-plugin-svelte",
        "purgecss",
        "stylelint",
        "stylelint-config-recommended",
        "stylelint-config-standard",
        "svelte-eslint-parser",
        "svgo",
        "syncpack",
        "typescript",
        "typescript-eslint",
        "v8r",
        "vue-eslint-parser",
        "wrangler",
        "@socketsecurity/bun-security-scanner",
        "^@fontsource-variable/",
        "^tree-sitter-"
    ],
    "ignoreBinaries": [
        "actionlint",
        "astro-check",
        "basedpyright",
        "codeql",
        "commitlint",
        "deptry",
        "editorconfig-checker",
        "eslint",
        "gitleaks",
        "html-validate",
        "jscpd",
        "knip",
        "license-checker-rseidelsohn",
        "linkinator",
        "lint-imports",
        "lychee",
        "markdownlint-cli2",
        "node",
        "osv-scanner",
        "pinact",
        "prettier",
        "purgecss",
        "pydoclint",
        "ruff",
        "semgrep",
        "shellcheck",
        "stylelint",
        "svgo",
        "syncpack",
        "taplo",
        "trufflehog",
        "tsc",
        "typos",
        "uv",
        "v8r",
        "vale",
        "wrangler",
        "yamllint",
        "zizmor",
        "mise"
    ],
    "ignoreExportsUsedInFile": true,
    "workspaces": {
        ".": {
            "entry": [
                "packages/cli/src/checks/general/site/linkinator.ts",
                "packages/eslint-plugin/src/rules/public.ts",
                "docs/src/content/reference/collection.ts",
                "scripts/setting-values.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ]
        },
        "docs": {
            "entry": [
                "src/content/reference/collection.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ],
            "ignoreDependencies": ["satteri"]
        },
        "packages/cli": {
            "entry": [
                "src/checks/general/site/linkinator.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ]
        },
        "packages/eslint-plugin": {
            "entry": [
                "src/rules/public.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ]
        },
        "tests": {
            "entry": [
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ],
            "ignoreDependencies": ["^.+$"]
        }
    }
}
