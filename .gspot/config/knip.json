{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "**/build.ts",
        "packages/cli/scripts/command.ts",
        "packages/cli/scripts/inputs.ts",
        "**/publish.ts",
        "packages/cli/src/agents/lint.ts",
        "packages/npm/gspot.js",
        "docs/src/content/reference/collection.ts",
        "docs/astro.config.ts",
        "docs/src/content.config.ts",
        "docs/src/route-metadata.ts",
        "tests/support/cli/swiftformat.ts",
        "tests/support/registry/install.ts",
        "tests/support/release/run.ts",
        "src/main.{ts,js}",
        "src/index.{ts,js}",
        "src/server.{ts,js}",
        "src/plugin.{ts,js}",
        "scripts/**/*.{ts,js,mjs}",
        "**/*.{test,spec}.{ts,tsx,js}",
        "tests/**/*.{ts,js}",
        "build.ts",
        "publish.ts"
    ],
    "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
    "ignore": [".gspot/**", "eslint.config.{js,mjs,cjs}"],
    "ignoreDependencies": [
        "@gspot/eslint-plugin",
        "eslint-config-prettier",
