                "src/index.{ts,js}",
                "src/server.{ts,js}",
                "src/plugin.{ts,js}",
                "scripts/**/*.{ts,js,mjs}",
                "**/*.{test,spec}.{ts,tsx,js}",
                "tests/**/*.{ts,js}",
                "build.ts",
                "publish.ts"
            ],
            "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
        },
        "packages/cli": {
            "entry": [
                "**/build.ts",
                "scripts/command.ts",
                "scripts/inputs.ts",
                "**/publish.ts",
                "src/agents/lint.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "src/server.{ts,js}",
                "src/plugin.{ts,js}",
                "scripts/**/*.{ts,js,mjs}",
                "**/*.{test,spec}.{ts,tsx,js}",
                "tests/**/*.{ts,js}",
                "build.ts",
                "publish.ts"
            ],
            "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
        },
        "packages/eslint-plugin": {
            "entry": [
                "**/build.ts",
                "**/publish.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "src/server.{ts,js}",
                "src/plugin.{ts,js}",
                "scripts/**/*.{ts,js,mjs}",
                "**/*.{test,spec}.{ts,tsx,js}",
                "tests/**/*.{ts,js}",
                "build.ts",
                "publish.ts"
            ],
            "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
        },
        "docs": {
            "entry": [
                "**/build.ts",
                "**/publish.ts",
                "src/content/reference/collection.ts",
                "astro.config.ts",
                "src/content.config.ts",
                "src/route-metadata.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "src/server.{ts,js}",
                "src/plugin.{ts,js}",
                "scripts/**/*.{ts,js,mjs}",
                "**/*.{test,spec}.{ts,tsx,js}",
                "tests/**/*.{ts,js}",
                "build.ts",
                "publish.ts"
            ],
            "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
        },
        "tests": {
            "entry": [
                "**/build.ts",
                "**/publish.ts",
                "support/cli/swiftformat.ts",
                "support/registry/install.ts",
                "support/release/run.ts"
            ],
            "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
            "ignoreDependencies": ["^.+$"]
        }
