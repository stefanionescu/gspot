        "eslint-plugin-jest",
        "eslint-plugin-jsdoc",
        "eslint-plugin-n",
        "eslint-plugin-package-json",
        "eslint-plugin-regexp",
        "eslint-plugin-security",
        "eslint-plugin-sonarjs",
        "eslint-plugin-unicorn",
        "globals",
        "jscpd",
        "knip",
        "license-checker-rseidelsohn",
        "markdownlint-cli2",
        "postcss-html",
        "prettier",
        "stylelint",
        "stylelint-config-standard",
        "syncpack",
        "typescript",
        "typescript-eslint",
        "v8r",
        "^tree-sitter-",
        "^@fontsource-variable/"
