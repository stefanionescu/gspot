{
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all",
    "semi": true,
    "endOfLine": "lf",
    "arrowParens": "always",
    "embeddedLanguageFormatting": "off",
    "plugins": ["../../.gspot/node_modules/prettier-plugin-astro/dist/index.js"],
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        }
    ]
}
