{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "**/build.ts",
        "**/publish.ts",
        "packages/cli/schemas.ts",
        "packages/cli/src/rules/command.ts",
        "packages/npm/gspot/gspot.js",
        "docs/reference-pages.ts",
        "docs/astro.config.ts",
        "docs/src/content.config.ts",
        "src/main.{ts,js}",
        "src/index.{ts,js}",
