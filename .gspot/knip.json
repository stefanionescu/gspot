    "ignoreExportsUsedInFile": true,
    "workspaces": {
        ".": {
            "entry": [
                "**/build.ts",
                "**/publish.ts",
                "packages/cli/schemas.ts",
                "packages/cli/src/rules/command.ts",
                "packages/npm/gspot/gspot.js",
                "docs/reference-pages.ts",
                "docs/astro.config.ts",
                "docs/src/content.config.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "src/plugin.{ts,js}",
                "**/*.{test,spec}.{ts,tsx,js}",
                "tests/**/*.{ts,js}",
                "build.ts",
                "publish.ts"
            ],
            "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
        },
        "packages/cli": {
            "entry": [
                "**/build.ts",
                "**/publish.ts",
                "schemas.ts",
                "src/rules/command.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "src/plugin.{ts,js}",
                "**/*.{test,spec}.{ts,tsx,js}",
                "tests/**/*.{ts,js}",
                "build.ts",
                "publish.ts"
            ],
            "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
        },
        "packages/eslint-plugin": {
            "entry": [
                "**/build.ts",
                "**/publish.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "src/plugin.{ts,js}",
                "**/*.{test,spec}.{ts,tsx,js}",
                "tests/**/*.{ts,js}",
                "build.ts",
                "publish.ts"
            ],
            "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
        },
        "docs": {
            "entry": [
                "**/build.ts",
                "**/publish.ts",
                "reference-pages.ts",
                "astro.config.ts",
                "src/content.config.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "src/plugin.{ts,js}",
                "**/*.{test,spec}.{ts,tsx,js}",
                "tests/**/*.{ts,js}",
                "build.ts",
                "publish.ts"
            ],
            "project": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
