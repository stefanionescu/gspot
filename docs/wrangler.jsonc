{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "gspot-docs",
    "compatibility_date": "2026-10-03",
    "workers_dev": false,
    "routes": [{ "pattern": "gspot.dev", "custom_domain": true }],
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
    },
}
