---
import { listGuideChecks } from '../reference/checks.ts';

type Props = {
    configurations: string[];
}

// A summary marks code with backticks; splitting on each code span keeps the span, backticks included.
const rows = listGuideChecks(Astro.props.configurations).map((check) => ({
    ...check,
    parts: check.summary.split(/(`[^`]*`)/u),
}));
---

<table>
    <thead>
        <tr>
            <th>Check</th>
            <th>Stage</th>
            <th>What it does</th>
        </tr>
    </thead>
    <tbody>
        {
            rows.map(({ name, link, stage, parts }) => (
                <tr>
                    <td>
                        <a href={link}>
                            <code>{name}</code>
                        </a>
                    </td>
                    <td>
                        <code>{stage}</code>
                    </td>
                    <td>{parts.map((part) => (part.startsWith('`') ? <code>{part.slice(1, -1)}</code> : part))}</td>
                </tr>
            ))
        }
    </tbody>
</table>
