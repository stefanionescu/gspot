---
import InlineText from './InlineText.astro';
import { listGuideChecks } from '../reference/checks.ts';

type Props = {
    configurations: string[];
};

const rows = listGuideChecks(Astro.props.configurations);
---

<table>
    <thead>
        <tr>
            <th>Check</th>
            <th>Stage</th>
            <th>What it does</th>
        </tr>
    </thead>
    <tbody>
        {rows.map(({ name, link, stage, summary }) => (
            <tr>
                <td>
                    <a href={link}>
                        <code>{name}</code>
                    </a>
                </td>
                <td>
                    <code>{stage}</code>
                </td>
                <td>
                    <InlineText text={summary} />
                </td>
            </tr>
        ))}
    </tbody>
</table>
