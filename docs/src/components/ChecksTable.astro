---
const { checksTable } = Astro.locals.starlightRoute.entry.data;
if (checksTable === undefined) throw new Error(`The guide ${Astro.locals.starlightRoute.id} has no check table.`);
---

{/* eslint-disable-next-line astro/no-set-html-directive -- reason: The loader renders escaped shipped check metadata through Astro's Markdown renderer. */}
<Fragment set:html={checksTable} />
