---
import { Image } from 'astro:assets';
import hero from '#docs/assets/hero.avif';
import { DOCS_PATH } from '#docs/config/site.ts';
import { HOME_TITLE } from '#docs/config/home.ts';
import Setup from '#docs/components/home/setup/Setup.astro';
import cliPackage from '@gspothq/cli/package.json' with { type: 'json' };
---

<section class="hero" aria-labelledby="_top">
    <div class="hero-copy">
        <h1 id="_top">{HOME_TITLE}</h1>
        <p class="lead">{cliPackage.description}</p>
        <Setup />
        <a class="hero-docs" href={DOCS_PATH}>
            Read the docs →
        </a>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <Image src={hero} alt="" width={400} height={400} loading="eager" decoding="async" fetchpriority="high" />
    </div>
</section>
