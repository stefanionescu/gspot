---
import hero from '#docs/assets/hero.avif';
import { DOCS_PATH } from '#docs/config/site.ts';
import { HOME_TITLE } from '#docs/config/home.ts';
import heroSmall from '#docs/assets/hero-384.avif';
import cliPackage from '#cli-package' with { type: 'json' };
import Setup from '#docs/components/home/setup/Setup.astro';
---

<section class="hero not-content" aria-labelledby="_top">
    <div class="hero-copy">
        <h1 id="_top">{HOME_TITLE}</h1>
        <p class="lead">{cliPackage.description}</p>
        <Setup />
        <a class="hero-docs" href={DOCS_PATH}>
            Read the docs
        </a>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <img
            src={hero.src}
            srcset={`${heroSmall.src} 384w, ${hero.src} 640w`}
            sizes="(min-width: 50rem) 400px, 128px"
            alt=""
            width="400"
            height="400"
            loading="eager"
            decoding="async"
            fetchpriority="high"
        />
    </div>
</section>
