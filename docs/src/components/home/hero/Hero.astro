---
import hero from '#docs/assets/hero.webp';
import { HOME_TITLE } from '#docs/config/home.ts';
import Setup from '#docs/components/home/setup/Setup.astro';
import { DOCS_PATH, DESCRIPTION } from '#docs/config/site.ts';
---

<section class="hero" aria-labelledby="_top">
    <div class="hero-copy">
        <h1 id="_top">{HOME_TITLE}</h1>
        <p class="lead">{DESCRIPTION}</p>
        <Setup />
        <a class="hero-docs" href={DOCS_PATH}>
            Read the docs →
        </a>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <img src={hero.src} alt="" width="800" height="800" fetchpriority="high" />
    </div>
</section>
