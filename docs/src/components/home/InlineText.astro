---
import { INLINE_CODE_SPAN } from '../../config/home.ts';

type Props = { text: string };
const { text } = Astro.props;
const parts = text
    .split(INLINE_CODE_SPAN)
    .map((part) => ({ text: part.replaceAll('`', ''), code: part.startsWith('`') }));
---

{parts.map((part) => (part.code ? <code>{part.text}</code> : part.text))}
