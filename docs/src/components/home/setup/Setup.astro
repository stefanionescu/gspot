---
import { setup, AGENT_PROMPT } from '#docs/reference/setup.ts';
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
---

<div class="setup">
    <Tabs>
        <TabItem label="Human">
            <Tabs syncKey="package-manager">
                {setup.map(({ label, lines }) => (
                    <TabItem label={label}>
                        <Code code={lines.join('\n')} lang="shell" />
                    </TabItem>
                ))}
            </Tabs>
        </TabItem>
        <TabItem label="Agent">
            <Code code={AGENT_PROMPT} lang="text" />
        </TabItem>
    </Tabs>
</div>
