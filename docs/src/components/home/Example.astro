---
import ExampleRun from './ExampleRun.astro';
import InlineText from '../InlineText.astro';
import example from '../../config/example.json';
import { tokenizeExampleLine } from './example.ts';

const beforeLines = example.agent.files
    .flatMap(({ content }) =>
        content
            .trimEnd()
            .split('\n')
            .map((text, index) => ({ number: index + 1, tokens: tokenizeExampleLine(text) })),
    )
    .map((line) => ({
        ...line,
        issue: example.issues.findIndex(({ lines }) => lines.includes(line.number)) + 1,
    }));
const afterLines = example.fix.files
    .flatMap(({ content }) =>
        content
            .trimEnd()
            .split('\n')
            .map((text, index) => ({ number: index + 1, tokens: tokenizeExampleLine(text) })),
    )
    .map((line) => ({
        ...line,
        inserted: example.fix.inserted_lines.includes(line.number),
    }));
---

<div class="example-grid">
    <figure class="panel before">
        <figcaption class="panel-head">
            <span>Before: what the agent wrote</span>
            <span class="file">{example.agent.files.map(({ path }) => path)}</span>
        </figcaption>
        <div class="panel-body">
            <code class="code">
                {beforeLines.map(({ number, issue, tokens }) => (
                    <span class:list={['line', { 'is-marked': issue > 0 }]}>
                        <span class:list={{ badge: issue > 0 }}>
                            {issue > 0 && (
                                <>
                                    <span class="sr-only">Problem </span>
                                    {issue}
                                </>
                            )}
                        </span>
                        <span class="number" aria-hidden="true">
                            {number}
                        </span>
                        <span>
                            {tokens.map(({ text, kind }) => (
                                <span class:list={[kind]}>{text}</span>
                            ))}
                        </span>
                    </span>
                ))}
            </code>
        </div>
        <ol class="issues">
            {example.issues.map(({ title, text }, index) => (
                <li>
                    <span class="badge" aria-hidden="true">
                        {index + 1}
                    </span>
                    <span>
                        <strong>{title}</strong> <InlineText text={text} />
                    </span>
                </li>
            ))}
        </ol>
    </figure>
    <ExampleRun status="failed" summary={example.rejected_summary} />
    <figure class="panel after">
        <figcaption class="panel-head">
            <span>After: the fix</span>
            <span class="file">{example.fix.files.map(({ path }) => path)}</span>
        </figcaption>
        <div class="panel-body">
            <code class="code">
                {afterLines.map(({ number, inserted, tokens }) => (
                    <span class:list={['line', { 'is-inserted': inserted }]}>
                        <span></span>
                        <span class="number" aria-hidden="true">
                            {number}
                        </span>
                        <span>
                            {tokens.map(({ text, kind }) => (
                                <span class:list={[kind]}>{text}</span>
                            ))}
                        </span>
                    </span>
                ))}
            </code>
        </div>
        <p class="panel-note">
            <code class="inline-code">pay</code> now waits for the charge, and a failed payment reaches the caller.
        </p>
    </figure>
    <ExampleRun status="passed" />
</div>
