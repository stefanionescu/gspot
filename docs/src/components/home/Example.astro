---
import ExampleRun from './ExampleRun.astro';
import InlineText from '../InlineText.astro';
import example from '../../config/example.json';
import { buildExampleLines } from './example.ts';

const beforeLines = example.agent.files
    .flatMap(({ content }) => buildExampleLines(content))
    .map((line) => ({
        ...line,
        problem: example.problems.findIndex(({ lines }) => lines.includes(line.number)) + 1,
        inserted: false,
    }));
const afterLines = example.fix.files
    .flatMap(({ content }) => buildExampleLines(content))
    .map((line) => ({
        ...line,
        inserted: example.fix.inserted_lines.includes(line.number),
        problem: 0,
    }));
const summaries = [
    { status: 'failed', summary: example.rejected_summary },
    { status: 'passed', summary: example.passed },
];
---

<div class="example-grid">
    {summaries.map(({ status, summary }) => (
        <>
            <figure class:list={['panel', { before: status === 'failed', after: status !== 'failed' }]}>
                <figcaption class="panel-head">
                    <span>{status === 'failed' ? 'Before: what the agent wrote' : 'After: the fix'}</span>
                    <span class="file">
                        {(status === 'failed' ? example.agent : example.fix).files.map(({ path }) => path)}
                    </span>
                </figcaption>
                <div class="panel-body">
                    <code class="code">
                        {(status === 'failed' ? beforeLines : afterLines).map(
                            ({ number, problem, inserted, tokens }) => (
                                <span class:list={['line', { 'is-marked': problem > 0, 'is-inserted': inserted }]}>
                                    <span class:list={{ badge: problem > 0 }}>
                                        {problem > 0 && (
                                            <>
                                                <span class="sr-only">Problem </span>
                                                {problem}
                                            </>
                                        )}
                                    </span>
                                    <span class="number" aria-hidden="true">
                                        {number}
                                    </span>
                                    <span>
                                        {tokens.map(({ text, kind }) => (
                                            <span class:list={[kind]}>{text}</span>
                                        ))}
                                    </span>
                                </span>
                            ),
                        )}
                    </code>
                </div>
                {status === 'failed' ? (
                    <ol class="problems">
                        {example.problems.map(({ title, text }, index) => (
                            <li>
                                <span class="badge" aria-hidden="true">
                                    {index + 1}
                                </span>
                                <span>
                                    <strong>{title}</strong> <InlineText text={text} />
                                </span>
                            </li>
                        ))}
                    </ol>
                ) : (
                    <p class="panel-note">
                        <code class="inline-code">pay</code> now waits for the charge, and a failed payment reaches the
                        caller.
                    </p>
                )}
            </figure>
            <ExampleRun {status} {summary} />
        </>
    ))}
</div>
