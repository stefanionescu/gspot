---
import { CAUGHT_EXAMPLE } from '#docs/config/home.ts';

const { added, pulled, check, lockfile, advisory, summary, fix, fixedIn } = CAUGHT_EXAMPLE;
---

<ol class="caught not-content">
    <li class="caught-step caught-step-flagged">
        <div class="caught-head">
            <h3><span class="caught-number" aria-hidden="true">1</span>The agent added</h3>
            <span class="caught-file">{added.file}</span>
        </div>
        <pre class="caught-code"><code><span class="caught-line"><span class="caught-key">"{added.table}"</span><span class="caught-punctuation">:</span> {'{'}</span><span class="caught-line caught-line-nested caught-line-flagged"><span class="caught-key">"{added.name}"</span><span class="caught-punctuation">:</span> <span class="caught-string">"{added.version}"</span></span><span class="caught-line">{'}'}</span></code></pre>
        <p class="caught-note">It pulls in {pulled.name} {pulled.version}.</p>
    </li>
    <li class="caught-step caught-step-stopped">
        <div class="caught-head">
            <h3><span class="caught-number" aria-hidden="true">2</span>gspot stopped the push</h3>
        </div>
        <div class="caught-finding">
            <p class="caught-command">$ git push</p>
            <span class="caught-check">{check}</span>
            <p class="caught-where">{lockfile} · {advisory}</p>
            <p class="caught-message">{pulled.name} {pulled.version}: {summary}</p>
        </div>
    </li>
    <li class="caught-step caught-step-fixed">
        <div class="caught-head">
            <h3><span class="caught-number" aria-hidden="true">3</span>The fix</h3>
            <span class="caught-file">{fix.file}</span>
        </div>
        <pre class="caught-code"><code><span class="caught-line"><span class="caught-key">"{fix.table}"</span><span class="caught-punctuation">:</span> {'{'}</span><span class="caught-line caught-line-nested caught-line-fixed"><span class="caught-key">"{fix.name}"</span><span class="caught-punctuation">:</span> <span class="caught-string">"{fix.version}"</span></span><span class="caught-line">{'}'}</span></code></pre>
        <p class="caught-note">{fix.name} {fixedIn} and later fix the advisory.</p>
    </li>
</ol>
