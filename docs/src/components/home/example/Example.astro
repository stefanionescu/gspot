---
import { Code } from '@astrojs/starlight/components';
import { CAUGHT_EXAMPLE } from '#docs/config/home.ts';
import InlineText from '#docs/components/InlineText.astro';

const REPLACEMENT_TEMPLATE = /`[^`]*`/gu;
const REPLACEMENT_FUNCTION = '() =>';
const { file, lines, message, before, after } = CAUGHT_EXAMPLE;
---

<div class="example">
    <figure class="panel">
        <figcaption class="panel-head">Before</figcaption>
        <Code code={before.join('\n')} lang="ts" title={file} del={REPLACEMENT_TEMPLATE} />
    </figure>
    <figure class="panel">
        <figcaption class="panel-head">
            <span class="run">gspot</span>
            <span class="status failed">Failed</span>
        </figcaption>
        <ol class="findings">
            {lines.map((line) => (
                <li>
                    <span class="location">
                        {file}:{line}
                    </span>
                    <span class="message">
                        <InlineText text={message} />
                    </span>
                </li>
            ))}
        </ol>
    </figure>
    <p class="example-note">
        <code>replace</code> treats <code>{'$&'}</code> in the new text as a special pattern, so any text with{' '}
        <code>{'$&'}</code> would come out wrong.
    </p>
    <figure class="panel">
        <figcaption class="panel-head">After</figcaption>
        <Code code={after.join('\n')} lang="ts" title={file} ins={REPLACEMENT_FUNCTION} />
    </figure>
</div>
