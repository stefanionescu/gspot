---
import example from '#docs/config/example.json';
import { Code } from '@astrojs/starlight/components';
import Run from '#docs/components/home/example/Run.astro';
import InlineText from '#docs/components/InlineText.astro';

const issueMarkers = example.issues.map(({ lines }, index) => ({ range: lines.join(','), label: String(index + 1) }));
const insertedLines = example.insertedLines.join(',');
---

<div class="example-grid">
    <figure class="panel before">
        <figcaption class="panel-head">
            <span>Before: what the agent wrote</span>
        </figcaption>
        <div class="panel-body">
            <Code code={example.before.content} lang="ts" title={example.before.path} mark={issueMarkers} />
        </div>
        <ol class="issues">
            {example.issues.map(({ title, text }, index) => (
                <li>
                    <span class="badge" aria-hidden="true">
                        {index + 1}
                    </span>
                    <span>
                        <strong>{title}</strong> <InlineText text={text} />
                    </span>
                </li>
            ))}
        </ol>
    </figure>
    <Run status="failed" summary={example.rejectedSummary} />
    <figure class="panel after">
        <figcaption class="panel-head">
            <span>After: the fix</span>
        </figcaption>
        <div class="panel-body">
            <Code code={example.after.content} lang="ts" title={example.after.path} ins={insertedLines} />
        </div>
        <p class="panel-note">
            <code>pay</code> now waits for the charge, and a failed payment reaches the caller.
        </p>
    </figure>
    <Run status="passed" summary={example.passedSummary} />
</div>
