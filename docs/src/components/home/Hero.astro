---
import example from '../../config/example.json';
import { version } from '#cli-package' with { type: 'json' };
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';

const agentFile = example.agent.files.find((file) => file.path === 'src/utils.ts');
if (agentFile === undefined) throw new Error('The homepage example has no src/utils.ts.');
const summary = example.rejected.trimEnd().split('\n').at(-1) ?? '';
---

<section class="home-hero" aria-labelledby="_top">
    <div class="hero-copy">
        <p class="purpose">
            gspot configures linters for your languages and runs checks in Git hooks and CI. It also installs
            instructions for coding agents.
        </p>
        <nav class="hero-actions" aria-label="Start using gspot">
            <a class="primary" href="/guides/install/">
                Get started <span aria-hidden="true">→</span>
            </a>
            <a href="/reference/commands/">View commands</a>
        </nav>
        <p>
            Choose the setup for your repository. <a href="/guides/requirements/">Check requirements first.</a>
        </p>
        <Tabs>
            <TabItem label="package.json">
                <Code
                    code={
                        'npm install --save-dev --save-exact @gspothq/cli\ngit add package.json package-lock.json\ngit commit -m "build: Add gspot"\nnpx gspot init'
                    }
                    lang="sh"
                    frame="none"
                />
            </TabItem>
            <TabItem label="mise">
                <Code code={`mise exec npm:@gspothq/cli@${version} -- gspot init`} lang="sh" frame="none" />
                <p>Choose mise as the runner. It pins the npm CLI and required executable tools.</p>
            </TabItem>
            <TabItem label="Global">
                <Code code={`npm install --global @gspothq/cli@${version}\ngspot init`} lang="sh" frame="none" />
                <p>One CLI version serves this machine. Match each repository's pin.</p>
            </TabItem>
        </Tabs>
    </div>
    <section class="hero-demo" aria-labelledby="hero-example">
        <div class="demo-heading">
            <h2 id="hero-example">An agent commits a wrapper</h2>
            <span>Findings excerpt · TypeScript · level all</span>
        </div>
        <Tabs>
            <TabItem label="1. Set up">
                <Code
                    code={`${example.commands.install}\ngit add package.json package-lock.json\ngit commit -m "build: Add gspot"\n${example.commands.init}\n${example.commands.level}\nnpx gspot install\nnpx gspot doctor`}
                    lang="sh"
                    frame="none"
                />
                <p class="demo-note">
                    Install gspot, accept the plan, and select level <code>all</code> conventions.
                </p>
            </TabItem>
            <TabItem label="2. Commit">
                <Code code={agentFile.content.trimEnd()} lang="typescript" title={agentFile.path} wrap />
                <Code code={`git commit -m "${example.agent.message}"`} lang="sh" frame="none" />
                <ul class="demo-findings">
                    {example.findings.map((finding) => (
                        <li>
                            <code>
                                {finding.file}:{finding.line}
                            </code>
                            <p>{finding.message}</p>
                            <span>
                                {finding.rule} · {finding.check}
                            </span>
                        </li>
                    ))}
                </ul>
                <p class="demo-status">{summary}</p>
            </TabItem>
            <TabItem label="3. Fix">
                <ul class="demo-corrections">
                    <li>
                        Delete <code>src/utils.ts</code>.
                    </li>
                    <li>
                        Call <code>calculateTotal</code> directly.
                    </li>
                </ul>
                <Code code={`git commit -m "${example.agent.message}"`} lang="sh" frame="none" />
                <p class="demo-status">{example.passed}</p>
            </TabItem>
        </Tabs>
        <a class="demo-guide" href="/guides/quickstart/typescript/">
            Run the TypeScript example <span aria-hidden="true">→</span>
        </a>
    </section>
</section>
