---
import Setup from './Setup.astro';
import { HOME_TITLE, HOME_DESCRIPTION } from '../../config/home.ts';
---

<section class="hero" aria-labelledby="_top">
    <div class="hero-copy">
        <h1 id="_top">{HOME_TITLE}</h1>
        <p class="lead">{HOME_DESCRIPTION}</p>
        <Setup />
    </div>
    <div class="hero-visual" aria-hidden="true">
        <img src="/brand/home/hero.webp" alt="" width="1024" height="1024" fetchpriority="high" />
    </div>
</section>
