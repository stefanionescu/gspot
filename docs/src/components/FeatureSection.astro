---
// Adapted from Turborepo's FeatureSection. See /licenses/turborepo.txt.
type Props = {
    title: string;
    description: string;
    features: { title: string; description: string; image: string; href: string; link: string }[];
};
const { title, description, features } = Astro.props;
---
<section class="feature-section">
    <h2>{title}</h2>
    <p class="section-description">{description}</p>
    <ul class="features">
        {features.map((feature) => (
            <li>
                <div class="illustration"><img src={feature.image} alt="" width="640" height="432" loading="lazy" /></div>
                <div class="feature-copy"><h3>{feature.title}</h3><p>{feature.description}</p><a href={feature.href}>{feature.link} <span aria-hidden="true">→</span></a></div>
            </li>
        ))}
    </ul>
</section>
<style>
    .feature-section { padding-block: 56px; }
    h2 { margin: 0 0 8px; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 500; }
    .section-description { max-width: 64ch; font-size: 1.125rem; color: var(--sl-color-gray-2); margin: 0; }
    .features { margin: 32px 0 0; display: grid; list-style: none; padding: 0; gap: 32px 24px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    li { display: flex; flex-direction: column; gap: 24px; margin: 0; min-width: 0; }
    .illustration { aspect-ratio: 40/27; overflow: hidden; border: 1px solid var(--sl-color-gray-5); border-radius: 6px; background: #0B1020; }
    .illustration img { width: 100%; height: 100%; object-fit: contain; }
    .features .feature-copy { margin: 0; }
    .feature-copy h3 { margin: 0; font-size: 1.0625rem; font-weight: 550; }
    .feature-copy p { margin: 8px 0 12px; font-size: 0.9375rem; color: var(--sl-color-gray-2); line-height: 1.7; }
    .feature-copy a { font-size: 0.875rem; }
    @media (max-width: 60rem) { .features { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 40rem) { .features { grid-template-columns: 1fr; }.feature-section { padding-block: 32px; } }
</style>
