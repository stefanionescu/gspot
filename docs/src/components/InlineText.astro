---
import { INLINE_CODE_SPAN } from '../config/reference.ts';

type Props = { text: string };
const { text } = Astro.props;
const spans = text
    .split(INLINE_CODE_SPAN)
    .map((span) => ({ text: span.replaceAll('`', ''), code: span.startsWith('`') }));
---

{spans.map((span) => (span.code ? <code>{span.text}</code> : span.text))}
