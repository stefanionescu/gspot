---
import SiteTitle from './SiteTitle.astro';
import ThemeSelect from './ThemeSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

// The landing page links to the docs from its footer; search and the Docs link sit on docs pages.
const isHome = Astro.url.pathname === '/';
---

<div class:list={['site-header', { home: isHome }]}>
    <SiteTitle />
    {
        !isHome && (
            <div class="search print:hidden">
                <Search />
            </div>
        )
    }
    <div class="controls print:hidden">
        <div class="social">
            <SocialIcons />
        </div>
        <ThemeSelect />
    </div>
</div>
<style>
.site-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 4px;
    height: 100%;
}
.site-header.home {
    grid-template-columns: minmax(0, 1fr) auto;
}
.search {
    justify-self: end;
}
.search :global(button[data-open-modal]) {
    margin-inline: auto;
}
.controls {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 4px;
}
:global(html:not([data-has-sidebar])) .site-header {
    max-width: var(--home-width);
    margin-inline: auto;
}
:global(html:not([data-has-sidebar])) .controls {
    margin-inline-end: -12px;
}
.social {
    display: none;
}
.social :global(a) {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-radius: 8px;
    color: var(--sl-color-gray-1);
    font-size: 1.25rem;
}
@media (hover: hover) {
    .social :global(a:hover) {
        background: var(--sl-color-gray-6);
        color: var(--sl-color-white);
    }
}

@media (width < 50rem) {
    .search :global(button[data-open-modal]) {
        width: 44px;
        height: 44px;
        padding: 0;
        justify-content: center;
        border-radius: 8px;
    }
}

@media (width >= 50rem) {
    .site-header:not(.home) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 24rem) minmax(0, 1fr);
        gap: 24px;
    }
    .search {
        justify-self: stretch;
    }
    .social {
        display: flex;
    }
}
</style>
