---
import SiteTitle from './SiteTitle.astro';
import ThemeSelect from './ThemeSelect.astro';
import { DOCS_PATH } from '../../config/site.ts';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const isHome = Astro.url.pathname === '/';
---

<!--
The landing page has no sidebar menu, so its Docs link and GitHub icon stay in the header at every width.
Docs pages hold search, and the Docs link sits beside the name.
-->
<div class:list={['site-header', { home: isHome }]}>
    <SiteTitle />
    {!isHome && (
        <div class="search print:hidden">
            <Search />
        </div>
    )}
    <div class="controls print:hidden">
        {isHome && (
            <a class="docs" href={DOCS_PATH}>
                Docs
            </a>
        )}
        <div class="social">
            <SocialIcons />
        </div>
        <ThemeSelect />
    </div>
</div>
<style>
.site-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 4px;
    height: 100%;
}
.site-header.home {
    grid-template-columns: minmax(0, 1fr) auto;
}
.search {
    justify-self: end;
}
.search :global(button[data-open-modal]) {
    margin-inline: auto;
}
.controls {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 4px;
}
:global(html:not([data-has-sidebar])) .site-header {
    max-width: var(--home-width);
    margin-inline: auto;
}
:global(html:not([data-has-sidebar])) .controls {
    margin-inline-end: -12px;
}
.docs {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-size);
    padding-inline: 8px;
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
    text-decoration: none;
}
.social {
    display: none;
}
.site-header.home .social {
    display: flex;
}
.social :global(a) {
    display: inline-grid;
    place-items: center;
    width: var(--target-size);
    height: var(--target-size);
    margin: 0;
    padding: 0;
    border-radius: 8px;
    color: var(--sl-color-gray-1);
    font-size: 1.25rem;
}
@media (hover: hover) {
    .docs:hover {
        color: var(--sl-color-white);
    }
    .social :global(a:hover) {
        background: var(--sl-color-gray-6);
        color: var(--sl-color-white);
    }
}

@media (width < 50rem) {
    .search :global(button[data-open-modal]) {
        width: var(--target-size);
        height: var(--target-size);
        padding: 0;
        justify-content: center;
        border-radius: 8px;
    }
}

@media (width >= 50rem) {
    .site-header:not(.home) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 24rem) minmax(0, 1fr);
        gap: 24px;
    }
    .search {
        justify-self: stretch;
    }
    .social {
        display: flex;
    }
}
</style>
