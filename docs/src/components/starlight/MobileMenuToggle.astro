---
import { Icon } from '@astrojs/starlight/components';
---

<button type="button" popovertarget="starlight__sidebar" class="icon-button menu-button print:hidden">
    <Icon name="bars" size="1.25rem" class="when-closed" />
    <Icon name="close" size="1.25rem" class="when-open" />
    <span class="when-closed">Menu</span>
    <span class="when-open">Close</span>
</button>

<style>
    .menu-button {
        position: fixed;
        z-index: var(--sl-z-index-navbar);
        top: var(--sl-nav-height);
        inset-inline-start: 4px;
        width: auto;
        gap: 8px;
        padding-inline: 12px;
        font-size: var(--sl-text-sm);
        font-weight: 500;
    }

    .menu-button:has(~ :popover-open) .when-closed,
    .menu-button:not(:has(~ :popover-open)) .when-open {
        display: none;
    }

    @media (width >= 50rem) {
        .menu-button {
            display: none;
        }
    }
</style>

<style is:global>
    body:has(.sidebar-pane:popover-open) {
        overflow: hidden;
    }
</style>
