---
import { DOCS_PATH } from '../../config/site.ts';
---

<div class="brand-navigation">
    <a class="site-title" href="/" aria-label="gspot home">
        <img class="brand-mark" src="/brand/mark.webp" alt="" width="28" height="28" />
        <span>gspot</span>
    </a>
    {Astro.url.pathname !== '/' && (
        <a href={DOCS_PATH} aria-current="location">
            Docs
        </a>
    )}
</div>
<style>
.brand-navigation {
    display: flex;
    align-items: center;
    gap: 24px;
}
a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: 0.9375rem;
    min-height: var(--target-size);
    display: inline-flex;
    align-items: center;
}
a[aria-current] {
    color: var(--sl-color-white);
}
.site-title {
    color: var(--sl-color-white);
    font-size: 1.375rem;
    gap: 8px;
    font-weight: 550;
}
/* Trim the text box to the x-height, so the lowercase name centers on the mark and not on its descenders. */
.site-title span {
    text-box: trim-both ex alphabetic;
}
.brand-mark {
    display: block;
    width: 28px;
    height: 28px;
}

@media (hover: hover) { a:hover { color: var(--sl-color-white); } }
</style>
