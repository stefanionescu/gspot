---
import Head from '@astrojs/starlight/components/Head.astro';
import RuleRedirect from '#docs/components/starlight/RuleRedirect.astro';
import { REFERENCE_PATH, REFERENCE_FOLDERS } from '#docs/config/reference.ts';
import { SOCIAL_IMAGE, SECTION_IMAGES, SECTION_SEGMENT } from '#docs/config/site.ts';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

const section = SECTION_SEGMENT.exec(Astro.url.pathname)?.groups?.['section'] ?? '';
const sectionImage = SECTION_IMAGES.get(section);
const image =
    sectionImage === undefined
        ? SOCIAL_IMAGE
        : { path: sectionImage.path, alt: `The gspot name and logo, with the section name ${sectionImage.name}.` };
---

<Head />
<meta property="og:image" content={new URL(image.path, Astro.site).href} />
<meta property="og:image:width" content={String(SOCIAL_IMAGE.width)} />
<meta property="og:image:height" content={String(SOCIAL_IMAGE.height)} />
<meta property="og:image:alt" content={image.alt} />
<link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
{Astro.url.pathname === `${REFERENCE_PATH}${REFERENCE_FOLDERS.eslintPlugin}/` && <RuleRedirect />}
