---
import Default from '@astrojs/starlight/components/Sidebar.astro';
---

<Default />
<script is:inline>
    (() => {
        if (!matchMedia('(min-width: 50em)').matches) return;
        const pane = document.querySelector('#starlight__sidebar');
        const link = pane.querySelector('a[aria-current="page"]');
        if (link === null || pane.scrollTop > 0) return;
        if (link.getBoundingClientRect().bottom > innerHeight) link.scrollIntoView({ block: 'center' });
    })();
</script>
