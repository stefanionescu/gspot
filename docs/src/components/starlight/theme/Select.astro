---
import { Icon } from '@astrojs/starlight/components';
import { THEME_STORAGE_KEY, THEME_SWITCH_LABELS } from '#docs/config/site.ts';
---

<theme-toggle data-storage-key={THEME_STORAGE_KEY} data-light-label={THEME_SWITCH_LABELS.light}>
    <button type="button" class="theme-toggle" aria-label={THEME_SWITCH_LABELS.dark} title={THEME_SWITCH_LABELS.dark}>
        <span class="moon">
            <Icon name="moon" size="1.25rem" />
        </span>
        <span class="sun">
            <Icon name="sun" size="1.25rem" />
        </span>
    </button>
</theme-toggle>

<script>

    class ThemeToggle extends HTMLElement {
        connectedCallback(): void {
            const button = this.querySelector('button') as HTMLButtonElement;
            const root = document.documentElement;
            const darkLabel = button.title;
            const refreshLabel = (): void => {
                const text = root.dataset['theme'] === 'light' ? (this.dataset['lightLabel'] as string) : darkLabel;
                button.setAttribute('aria-label', text);
                button.title = text;
            };
            refreshLabel();
            button.addEventListener('click', () => {
                const next = root.dataset['theme'] === 'light' ? 'dark' : 'light';
                root.dataset['theme'] = next;
                refreshLabel();
                try {
                    localStorage.setItem((this.dataset['storageKey'] as string), next);
                } catch (error) {
                    if (!(error instanceof DOMException)) throw error;
                }
            });
        }
    }
    customElements.define('theme-toggle', ThemeToggle);
</script>

<style>
.theme-toggle {
    display: inline-grid;
    place-items: center;
    width: var(--target-size);
    height: var(--target-size);
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--sl-color-gray-1);
    cursor: pointer;
}
@media (hover: hover) {
    .theme-toggle:hover {
        background: var(--sl-color-gray-6);
        color: var(--sl-color-white);
    }
}
.moon,
.sun {
    display: contents;
}
:global([data-theme='light']) .moon,
:global([data-theme='dark']) .sun {
    display: none;
}
</style>
