---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { ImageMetadata } from 'astro';
import type { SvgComponent } from 'astro/types';

import cliPackage from '#cli-package' with { type: 'json' };
import Example from '#docs/components/home/example/Example.astro';
import Hero from '#docs/components/home/hero/Hero.astro';
import InlineText from '#docs/components/InlineText.astro';
import { HOME_TITLE, TOOLS } from '#docs/config/home.ts';
import { REFERENCE_FOLDERS, REFERENCE_PATH } from '#docs/config/reference.ts';
import { DOCS_PATH, NPM_URL, REPOSITORY_URL } from '#docs/config/site.ts';

const BENEFITS = [
    {
        title: 'Catch problems before every commit',
        text: 'When you commit, gspot checks the files you changed. If it finds problems, the commit stops and gspot lists each one.',
        icon: ['M12 3l7 3v5c0 4.5-3 8.4-7 10-4-1.6-7-5.5-7-10V6l7-3z', 'M9 12l2 2 4-4'],
    },
    {
        title: 'Set up all your linters with one command',
        text: 'Run `gspot init`. It finds the languages and frameworks in your repository, picks the right linters and formatters, and writes their settings for you.',
        icon: ['M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z', 'M7 9l3 3-3 3', 'M12 15h5'],
    },
    {
        title: 'Run the same tool versions everywhere',
        text: "Every tool is pinned to one version, so your machine, your teammates' machines, and CI run the same versions.",
        icon: ['M12 16v5', 'M8 3h8l-1 6 3 3v2H6v-2l3-3-1-6z'],
    },
    {
        title: 'Teach your coding agent the rules',
        text: 'gspot adds rules to `AGENTS.md` that tell coding agents how to write code that passes the checks.',
        icon: ['M6 3h9l4 4v14H6z', 'M14 3v5h5', 'M9 13h7', 'M9 17h5'],
    },
    {
        title: 'Keep your formatting settings',
        text: '`gspot init` copies the indentation, line width, and quote style from your Prettier, EditorConfig, or Ruff settings. With none of those, it uses the defaults of each formatter.',
        icon: ['M4 6h16', 'M4 12h10', 'M4 18h14'],
    },
    {
        title: 'Keep secrets and vulnerable packages out',
        text: 'A commit that adds an API key or a token stops. A push stops when a dependency has a known security hole.',
        icon: ['M4 15a4 4 0 1 0 8 0a4 4 0 1 0-8 0', 'M10.9 12.1L20 3', 'M16 7l3 3', 'M13.5 9.5l2 2'],
    },
] as const;
const icons = import.meta.glob<SvgComponent>('../assets/tools/*.svg', { eager: true, import: 'default' });
const images = import.meta.glob<ImageMetadata>('../assets/tools/*.png', { eager: true, import: 'default' });
const tools = TOOLS.map(({ name, icon }) => {
    const Icon = icons[`../assets/tools/${icon}`];
    const image = images[`../assets/tools/${icon}`];
    if (Icon === undefined && image === undefined) throw new Error(`Missing tool image: ${icon}.`);
    return { name, Icon, image };
});
---

<StarlightPage
    frontmatter={{
        title: HOME_TITLE,
        description: cliPackage.description,
        template: 'splash',
        hero: {},
        editUrl: false,
        lastUpdated: false,
        prev: false,
        next: false,
        tableOfContents: false,
    }}
>
    <Hero />
    <div class="landing not-content">
        <section class="tools" aria-labelledby="tools-label">
            <p class="tools-label" id="tools-label">
                Runs the tools your code needs
            </p>
            <ul>
                {tools.map(({ name, Icon, image }) => (
                    <li>
                        {Icon === undefined ? (
                            <img class="tool-image" src={image?.src} alt="" width="28" height="28" />
                        ) : (
                            <Icon class="tool-icon" aria-hidden="true" />
                        )}
                        {name}
                    </li>
                ))}
            </ul>
        </section>
        <section class="section" aria-labelledby="example-title">
            <div class="intro">
                <h2 id="example-title">Caught in gspot's own code</h2>
                <p class="lead">
                    A coding agent added a package that brought in a known security hole. gspot stopped the push.
                </p>
            </div>
            <Example />
        </section>
        <section class="section" aria-labelledby="benefits-title">
            <div class="intro">
                <h2 id="benefits-title">What you get</h2>
            </div>
            <ul class="cards">
                {BENEFITS.map(({ title, text, icon }) => (
                    <li class="card">
                        <svg
                            class="use-icon"
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            {icon.map((path) => (
                                <path d={path} />
                            ))}
                        </svg>
                        <h3>{title}</h3>
                        <p>
                            <InlineText text={text} />
                        </p>
                    </li>
                ))}
            </ul>
            <p class="more">
                <a href={`${REFERENCE_PATH}${REFERENCE_FOLDERS.checks}/`}>See all checks</a>
            </p>
        </section>
    </div>
    <footer class="home-footer">
        <div class="home-footer-content">
            <span>gspot · {cliPackage.license}</span>
            <nav aria-label="Footer">
                <a href={DOCS_PATH}>Docs</a>
                <a href={NPM_URL}>npm</a>
                <a href={REPOSITORY_URL}>GitHub</a>
            </nav>
        </div>
    </footer>
</StarlightPage>
