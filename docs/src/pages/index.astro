---
import { REPOSITORY_URL } from '../config/site.ts';
import Example from '../components/home/Example.astro';
import InlineText from '../components/home/InlineText.astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import '../components/home/page.css';
import { TOOLS, HOME_TITLE, CHECK_AREAS, HOME_DESCRIPTION, HOME_AGENT_INSTRUCTIONS } from '../config/home.ts';
---

<StarlightPage
    frontmatter={{
        title: HOME_TITLE,
        description: HOME_DESCRIPTION,
        hero: { title: HOME_TITLE },
        template: 'splash',
        editUrl: false,
        lastUpdated: false,
        prev: false,
        next: false,
        head: [
            {
                tag: 'link',
                attrs: {
                    rel: 'alternate',
                    type: 'text/plain',
                    href: '/llms.txt',
                    title: 'Instructions for coding agents',
                },
            },
            { tag: 'script', attrs: { type: 'text/llms.txt' }, content: HOME_AGENT_INSTRUCTIONS },
        ],
    }}
>
    <div class="landing not-content">
        <section class="tools" aria-labelledby="tools-label">
            <p class="tools-label" id="tools-label">
                Works with these tools
            </p>
            <ul>
                {TOOLS.map(({ name, icon }) => (
                    <li>
                        <span class="tool-icon" style={`--icon: url(${icon})`} aria-hidden="true"></span>
                        {name}
                    </li>
                ))}
            </ul>
        </section>
        <section class="section example" aria-labelledby="example-title">
            <div class="intro">
                <h2 id="example-title">gspot stops the commit and names each problem</h2>
                <p class="lead">
                    An agent added a checkout function to a TypeScript project. It forgot{' '}
                    <code class="inline-code">await</code>, turned off the linter for one line, and left the{' '}
                    <code class="inline-code">catch</code> empty. The pre-commit hook found all three.
                </p>
            </div>
            <Example />
        </section>
        <section class="section handles" aria-labelledby="handles-title">
            <div class="intro">
                <h2 id="handles-title">What gspot checks</h2>
                <p class="lead">
                    <code class="inline-code">gspot init</code> reads your files and turns on the checks they need. Each
                    check runs a tool you know, pinned to one version on every machine and in CI.
                </p>
            </div>
            <ul class="cards">
                {CHECK_AREAS.map(({ title, text, tools }) => (
                    <li class="card">
                        <h3>{title}</h3>
                        <p>
                            <InlineText text={text} />
                        </p>
                        <p class="tool-names">
                            <InlineText text={tools} />
                        </p>
                    </li>
                ))}
            </ul>
            <p class="more">
                Also Gitleaks, typos, Vale, SwiftLint, Hadolint, Lychee, and more.{' '}
                <a href="/reference/checks/">All checks →</a>
            </p>
        </section>
        <footer class="home-footer">
            <div class="home-footer-content">
                <span>gspot · Apache-2.0</span>
                <nav aria-label="Footer">
                    <a href="/start/overview/">Docs</a>
                    <a href="https://www.npmjs.com/package/@gspothq/cli">npm</a>
                    <a href={REPOSITORY_URL}>GitHub</a>
                </nav>
            </div>
        </footer>
    </div>
</StarlightPage>
