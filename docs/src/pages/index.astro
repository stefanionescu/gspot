---
import { Code } from '@astrojs/starlight/components';
import Example from '../components/home/Example.astro';
import Features from '../components/home/Features.astro';
import { TOOLS, WORKFLOW, REPOSITORY } from '../config/home.ts';
import '../components/home/page.css';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
    frontmatter={{
        title: 'Lint AI generated code',
        description:
            'gspot configures linters, runs checks, and generates instructions for coding agents from one configuration file.',
        hero: { title: 'Lint AI generated code' },
        template: 'splash',
        editUrl: false,
        lastUpdated: false,
    }}
>
    <div class="landing">
        <section class="tool-strip" aria-label="Selected tools supported by gspot">
            <p>Works with these tools</p>
            <ul>
                {TOOLS.map(({ image, name, colored }) => (
                    <li>
                        <img src={image} class:list={{ colored }} alt="" width="24" height="24" />
                        <span>{name}</span>
                    </li>
                ))}
            </ul>
        </section>
        <Features
            title="Configure tools and check code"
            description="Choose checks in gspot.toml, generate tool configuration, and run them against your code."
            features={WORKFLOW}
        />
        <section class="demonstration" aria-labelledby="finding">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">JavaScript example</p>
                    <h2 id="finding">Check a JavaScript module</h2>
                </div>
                <a class="pill" href="/guides/client-environment/">
                    Run this example ↗
                </a>
            </div>
            <p>
                The gspot ESLint plugin flags this <code>process.env</code> access in a client module. Change the client
                to call an API route, then run the check again.
            </p>
            <Example />
        </section>
        <Features
            title="Configure the whole repository"
            description="Use the same configuration for agent instructions, nested projects, and generated files."
            features={REPOSITORY}
        />
        <section class="setup" aria-labelledby="setup">
            <div class="section-heading">
                <div>
                    <h2 id="setup">Set up a repository</h2>
                    <p>Install from source, select the JavaScript configuration, and run your first checks.</p>
                </div>
                <a class="pill" href="/guides/install/">
                    Get started ↗
                </a>
            </div>
            <div class="setup-grid">
                <div>
                    <Code
                        code={'version = 1\nconfigurations = ["javascript"]\nlevel = "recommended"'}
                        lang="toml"
                        title="gspot.toml"
                    />
                    <p>1. Select a configuration in your repository policy.</p>
                </div>
                <div>
                    <Code
                        code={'gspot apply --dry-run\ngspot apply\ngspot install'}
                        lang="sh"
                        title="Repository root"
                    />
                    <p>2. Preview, generate, and install selected tools.</p>
                </div>
                <div>
                    <Code
                        code={'gspot check\ngspot explain javascript/eslint\ngspot doctor'}
                        lang="sh"
                        title="Repository root"
                    />
                    <p>3. Check code and diagnose findings or setup.</p>
                </div>
            </div>
            <p class="setup-note">
                For a new configuration, <code>gspot init</code> proposes configurations and integrations before
                applying them. Initialization runs no checks.
            </p>
        </section>
        <section class="closing" aria-label="Next steps">
            <h2>Start linting your code.</h2>
            <nav>
                <a class="pill primary" href="/guides/install/">
                    Get started ↗
                </a>
                <a class="pill" href="/reference/commands/check/">
                    View commands
                </a>
            </nav>
        </section>
        <footer class="home-footer">
            <span>gspot · Apache-2.0</span>
            <a href="https://github.com/stefanionescu/gspot">Contribute</a>
        </footer>
    </div>
</StarlightPage>
