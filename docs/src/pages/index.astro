---
import type { ImageMetadata } from 'astro';
import InlineText from '#docs/components/InlineText.astro';
import Example from '#docs/components/home/example/Example.astro';
import { TOOLS, USE_CASES, HOME_TITLE } from '#docs/config/home.ts';
import '#docs/components/home/page.css';
import cliPackage from '@gspothq/cli/package.json' with { type: 'json' };
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { REFERENCE_PATH, REFERENCE_FOLDERS } from '#docs/config/reference.ts';
import { NPM_URL, DOCS_PATH, DESCRIPTION, REPOSITORY_URL } from '#docs/config/site.ts';

const images = import.meta.glob<ImageMetadata>('../assets/tools/*', { eager: true, import: 'default' });
const tools = TOOLS.map(({ name, icon }) => {
    const image = images[`../assets/tools/${icon}`];
    if (image === undefined) throw new Error(`Missing tool image: ${icon}.`);
    return { name, icon: image.src };
});
---

<StarlightPage
    frontmatter={{
        title: HOME_TITLE,
        description: DESCRIPTION,
        hero: { title: HOME_TITLE },
        template: 'splash',
        editUrl: false,
        lastUpdated: false,
        prev: false,
        next: false,
    }}
>
    <div class="landing not-content">
        <section class="tools" aria-labelledby="tools-label">
            <p class="tools-label" id="tools-label">
                Works with these tools
            </p>
            <ul>
                {tools.map(({ name, icon }) => (
                    <li>
                        <span class="tool-icon" style={`--icon: url(${icon})`} aria-hidden="true"></span>
                        {name}
                    </li>
                ))}
            </ul>
        </section>
        <section class="section example" aria-labelledby="example-title">
            <div class="intro">
                <h2 id="example-title">gspot stops the commit and names each problem</h2>
                <p class="lead">
                    An agent added a checkout function to a TypeScript project and made three mistakes. The pre-commit
                    hook found all three.
                </p>
            </div>
            <Example />
        </section>
        <section class="section handles" aria-labelledby="handles-title">
            <div class="intro">
                <h2 id="handles-title">What gspot does</h2>
                <p class="lead">
                    Run <code class="inline-code">gspot init</code> once. It looks at your repository and turns on the
                    checks it needs. Quick checks then run on every commit, slower ones before every push, and CI runs
                    them again on each pull request and on the default branch.
                </p>
            </div>
            <ul class="cards">
                {USE_CASES.map(({ title, text, icon }) => (
                    <li class="card">
                        <svg
                            class="use-icon"
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            {icon.map((path) => (
                                <path d={path} />
                            ))}
                        </svg>
                        <h3>{title}</h3>
                        <p>
                            <InlineText text={text} />
                        </p>
                    </li>
                ))}
            </ul>
            <p class="more">
                <a href={`${REFERENCE_PATH}${REFERENCE_FOLDERS.checks}/`}>See every check →</a>
            </p>
        </section>
        <footer class="home-footer">
            <div class="home-footer-content">
                <span>gspot · {cliPackage.license}</span>
                <nav aria-label="Footer">
                    <a href={DOCS_PATH}>Docs</a>
                    <a href={NPM_URL}>npm</a>
                    <a href={REPOSITORY_URL}>GitHub</a>
                </nav>
            </div>
        </footer>
    </div>
</StarlightPage>
