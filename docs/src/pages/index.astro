---
import { FEATURES } from '../config/home.ts';
import HomeHero from '../components/home/Hero.astro';
import Features from '../components/home/Features.astro';
import { description } from '#cli-package' with { type: 'json' };
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
    frontmatter={{
        title: 'Check code before it ships',
        description,
        template: 'splash',
        editUrl: false,
        lastUpdated: false,
    }}
>
    <div class="landing">
        <HomeHero />
        <Features
            title="What gspot does"
            description="It configures the linters of your languages, adds checks of its own, and runs them on every commit."
            features={FEATURES}
        />
        <footer class="home-footer">
            <div class="footer-about">
                <a href="/" class="footer-brand">
                    gspot
                </a>
            </div>
            <nav aria-label="Footer">
                <a href="/guides/overview/">Docs</a>
                <a href="https://github.com/stefanionescu/gspot">GitHub</a>
                <a href="https://github.com/stefanionescu/gspot/blob/main/LICENSE.md">Apache-2.0</a>
            </nav>
            <div class="footer-theme">
                <ThemeSelect />
            </div>
        </footer>
    </div>
</StarlightPage>
<style>
    .landing { max-width: 1200px; min-width: 0; }
    .landing > *, .landing :is(section, ul, li, nav, footer) { margin-block: 0; }
</style>
