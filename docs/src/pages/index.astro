---
import '../home.css';
import { FEATURES } from '../config/home.ts';
import { REPOSITORY_URL } from '../config/site.ts';
import HomeHero from '../components/home/Hero.astro';
import Features from '../components/home/Features.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { description } from '@gspothq/cli/package.json' with { type: 'json' };
---

<StarlightPage
    frontmatter={{
        title: 'Check code before it ships',
        description,
        template: 'splash',
        editUrl: false,
        lastUpdated: false,
    }}
>
    <div class="landing">
        <HomeHero />
        <Features
            title="What gspot does"
            description="It configures the linters of your languages, adds checks of its own, and runs them on every commit."
            features={FEATURES}
        />
        <footer class="home-footer">
            <div class="footer-about">
                <a href="/" class="footer-brand">
                    gspot
                </a>
            </div>
            <nav aria-label="Footer">
                <a href="/guides/overview/">Docs</a>
                <a href={REPOSITORY_URL}>GitHub</a>
                <a href={`${REPOSITORY_URL}/blob/main/LICENSE.md`}>Apache-2.0</a>
            </nav>
            <div class="footer-theme">
                <ThemeSelect />
            </div>
        </footer>
    </div>
</StarlightPage>
