---
import type { ImageMetadata } from 'astro';
import type { SvgComponent } from 'astro/types';
import Hero from '#docs/components/home/hero/Hero.astro';
import InlineText from '#docs/components/InlineText.astro';
import cliPackage from '#cli-package' with { type: 'json' };
import Example from '#docs/components/home/example/Example.astro';
import { TOOLS, USE_CASES, HOME_TITLE } from '#docs/config/home.ts';
import { NPM_URL, DOCS_PATH, REPOSITORY_URL } from '#docs/config/site.ts';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { REFERENCE_PATH, REFERENCE_FOLDERS } from '#docs/config/reference.ts';

const icons = import.meta.glob<SvgComponent>('../assets/tools/*.svg', { eager: true, import: 'default' });
const images = import.meta.glob<ImageMetadata>('../assets/tools/*.png', { eager: true, import: 'default' });
const tools = TOOLS.map(({ name, icon }) => {
    const Icon = icons[`../assets/tools/${icon}`];
    const image = images[`../assets/tools/${icon}`];
    if (Icon === undefined && image === undefined) throw new Error(`Missing tool image: ${icon}.`);
    return { name, Icon, image };
});
---

<StarlightPage
    frontmatter={{
        title: HOME_TITLE,
        description: cliPackage.description,
        template: 'splash',
        hero: {},
        editUrl: false,
        lastUpdated: false,
        prev: false,
        next: false,
        tableOfContents: false,
    }}
>
    <Hero />
    <div class="landing not-content">
        <section class="tools" aria-labelledby="tools-label">
            <p class="tools-label" id="tools-label">
                Runs the tools your code needs
            </p>
            <ul>
                {tools.map(({ name, Icon, image }) => (
                    <li>
                        {Icon === undefined ? (
                            <img class="tool-image" src={image?.src} alt="" width="28" height="28" />
                        ) : (
                            <Icon class="tool-icon" aria-hidden="true" />
                        )}
                        {name}
                    </li>
                ))}
            </ul>
        </section>
        <section class="section" aria-labelledby="example-title">
            <div class="intro">
                <h2 id="example-title">Caught in gspot's own code</h2>
                <p class="lead">
                    A coding agent wrote this code for this website. gspot reported both <code>replace</code> calls.
                </p>
            </div>
            <Example />
        </section>
        <section class="section" aria-labelledby="handles-title">
            <div class="intro">
                <h2 id="handles-title">What gspot does</h2>
                <p class="lead">
                    Run <code>gspot init</code> once. It looks at your repository and turns on the checks it needs.
                    Quick checks then run on every commit, slower ones before every push, and CI runs them again on each
                    pull request and on the default branch.
                </p>
            </div>
            <ul class="cards">
                {USE_CASES.map(({ title, text, icon }) => (
                    <li class="card">
                        <svg
                            class="use-icon"
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            {icon.map((path) => (
                                <path d={path} />
                            ))}
                        </svg>
                        <h3>{title}</h3>
                        <p>
                            <InlineText text={text} />
                        </p>
                    </li>
                ))}
            </ul>
            <p class="more">
                <a href={`${REFERENCE_PATH}${REFERENCE_FOLDERS.checks}/`}>See every check →</a>
            </p>
        </section>
    </div>
    <footer class="home-footer">
        <div class="home-footer-content">
            <span>gspot · {cliPackage.license}</span>
            <nav aria-label="Footer">
                <a href={DOCS_PATH}>Docs</a>
                <a href={NPM_URL}>npm</a>
                <a href={REPOSITORY_URL}>GitHub</a>
            </nav>
        </div>
    </footer>
</StarlightPage>
