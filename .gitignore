# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
*~
.idea/

# Dependencies
node_modules/

# Build output
*.tsbuildinfo

# Test coverage
coverage/

# Local environment
.env
.env.*
!.env.example
*.local

# Editor settings
.vscode/

# Logs and crash output
*.log
npm-debug.log*
bun-debug.log*

# gspot writes its own entries here as a managed block, from `gspot init`.
# Do not add /.gspot/ by hand.

# Build output and files copied from packages at build time
/dist/
/packages/cli/build/
/packages/cli/grammars/*.wasm
!/packages/cli/grammars/swift.wasm

# >>> gspot managed >>>
gspot.local.toml
.gspot/cache/
.gspot/report.json
.gspot/report.sarif
.gspot/vale/styles/Google/
.gspot/vale/styles/Microsoft/
.gspot/vale/styles/write-good/
.gspot/vale/styles/proselint/
.gspot/vale/styles/alex/
.gspot/vale/styles/RedHat/
.gspot/vale/styles/Readability/
.gspot/vale/styles/Harper/
.gspot/vale/styles/.vale-config/
.gspot/vale/styles/config/dictionaries/
# <<< gspot managed <<<

# Build output of the workspace packages
/packages/*/dist/
/docs/dist/
/docs/.astro/

# Scratch scripts of the session
/packages/cli/scratch/
