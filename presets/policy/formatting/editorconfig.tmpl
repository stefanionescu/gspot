<% const adopted = tool('editorconfig').adopted; if (adopted !== undefined) { %>
<% for (const [key, value] of Object.entries(adopted.preamble)) { %><%= key %> = <%= value %>
<% } for (const section of adopted.sections) { %>
[<%= section.glob %>]
<% for (const [key, value] of Object.entries(section.properties)) { %><%= key %> = <%= value %>
<% } } } else { %>
root = true

[*]
charset = utf-8
end_of_line = <%= format.line_ending %>
insert_final_newline = <%= format.newline_at_end %>
trim_trailing_whitespace = true
indent_style = <%= format.indent_style %>
indent_size = <%= format.indent_width %>

[*.{sh,bash,zsh}]
indent_style = <%= format.indent_style %>
indent_size = <%= format.indent_width %>
switch_case_indent = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
<% const extras = extra('editorconfig'); if (extras) { for (const [key, value] of Object.entries(extras)) { if (key !== 'reason' && typeof value === 'object' && value !== null) { %>
[<%= key %>]
<% for (const [option, setting] of Object.entries(value)) { %><%= option %> = <%= setting %>
<% } } } } %>
<% for (const entry of editorconfigOverrides()) { %>
[<%= entry.path %>]
<% for (const [key, value] of Object.entries(entry.options)) { %><%= key %> = <%= value %>
<% } } %>
<% } %>
