{
    "mode": "strict",
    "minLines": <%= settings['limits.duplication.min_lines'] ?? 8 %>,
    "minTokens": <%= settings['limits.duplication.min_tokens'] ?? 40 %>,
    "reporters": ["console"],
    "absolute": true,
    "gitignore": true,
    "ignore": <%= json(["**/.gspot/**", "**/*.md", "**/*.mdx", ...(settings['tools.jscpd.ignore'] ?? []).flatMap((entry) => entry.paths ?? [])], 0) %>
}
