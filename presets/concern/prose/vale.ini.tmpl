StylesPath = vale/styles
MinAlertLevel = suggestion
SkippedScopes = script, style, pre, figure, table
Packages = <%= prose.packages.join(', ') %>
Vocab = gspot

[*]
BasedOnStyles = Vale, gspot, <%= prose.packages.join(', ') %>
BlockIgnores = <%= prose.blockIgnores.join(', ') %>
TokenIgnores = <%= prose.tokenIgnores.join(', ') %>
<% for (const [rule, reason] of prose.disabledUpstream) { %># <%= json(reason, 0) %>
<%= rule %> = NO
<% } %><% for (const entry of policy.prose.disabled) { %># <%= json(entry.reason, 0) %>
<%= entry.rule %> = NO
<% } %>