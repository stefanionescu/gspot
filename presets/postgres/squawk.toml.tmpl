<% const squawk = tool('squawk'); const through = String(settings['tools.squawk.frozen_through'] ?? 'none'); const frozen = through === 'none' ? [] : files('.sql').filter((path) => { const version = /^(\d+)/.exec(path.slice(path.lastIndexOf('/') + 1))?.[1]; return version !== undefined && (through === 'all' || version <= through); }); %>assume_in_transaction = <%= (settings['tools.squawk.assume_in_transaction'] ?? false) || has('supabase') ? 'true' : 'false' %>
excluded_rules = <%= json(rulesOff('postgres/squawk'), 0) %>
excluded_paths = <%= json(frozen, 0) %>
