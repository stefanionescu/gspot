timeout: <%= settings['tools.trivy.timeout'] ?? '10m' %>
severity:
<% for (const level of String(settings['tools.trivy.severity'] ?? 'HIGH,CRITICAL').split(',')) { %>    - <%= level.trim() %>
<% } %>scan:
    skip-dirs:
        - node_modules
        - .gspot
        - .git
ignorefile: .gspot/trivyignore
