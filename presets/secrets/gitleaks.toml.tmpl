<% const entries = settings['tools.gitleaks.allow'] ?? []; %><% for (const entry of entries) { %># <%= json(entry.reason, 0) %>
<% } %><%~ toml({
    extend: { useDefault: true },
    ...(entries.length === 0 ? {} : { allowlists: entries.map((entry) => ({
        description: entry.description ?? entry.reason,
        ...((entry.paths ?? []).length > 0 ? { paths: entry.paths } : {}),
        ...((entry.regexes ?? []).length > 0 ? { regexes: entry.regexes } : {}),
        ...(entry.regex_target ? { regexTarget: entry.regex_target } : {}),
        ...(entry.condition ? { condition: entry.condition } : {}),
    })) }),
}).trimEnd() %>
