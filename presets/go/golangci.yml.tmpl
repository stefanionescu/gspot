version: "2"
run:
    timeout: 10m
    relative-path-mode: wd
    tests: true
linters:
    default: none
    enable:<% const off = new Set((settings['tools.golangci.disabled'] ?? []).map((entry) => (typeof entry === 'string' ? entry : entry.name))); for (const name of ['bodyclose', 'containedctx', 'contextcheck', 'copyloopvar', 'cyclop', 'dupl', 'durationcheck', 'errcheck', 'errname', 'errorlint', 'exhaustive', 'forcetypeassert', 'gocognit', 'goconst', 'gocritic', 'gosec', 'govet', 'ineffassign', 'misspell', 'nestif', 'nilerr', 'noctx', 'nolintlint', 'prealloc', 'predeclared', 'revive', 'rowserrcheck', 'sqlclosecheck', 'staticcheck', 'unconvert', 'unparam', 'unused', 'usestdlibvars', 'wastedassign'].filter((linter) => !off.has(linter))) { %>
        - <%= name %><% } %>
    settings:
        cyclop:
            max-complexity: 8
        gocognit:
            min-complexity: 8
        nestif:
            min-complexity: 4
        errcheck:
            check-type-assertions: true
            check-blank: true
        govet:
            enable-all: true
            disable:
                - fieldalignment
        nolintlint:
            require-explanation: true
            require-specific: true
        revive:
            rules:
                - name: exported
                - name: error-return
                - name: error-naming
                - name: context-as-argument
                - name: receiver-naming
                - name: var-naming
                - name: package-comments
    exclusions:
        generated: strict
issues:
    max-issues-per-linter: 0
    max-same-issues: 0
