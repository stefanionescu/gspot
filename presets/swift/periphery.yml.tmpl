<% const project = settings['tools.xcode.project'] ?? ''; const scheme = settings['tools.xcode.scheme'] ?? ''; if (project !== '') { -%>
project: <%= json(project, 0) %>
<% } if (scheme !== '') { -%>
schemes:
    - <%= json(scheme, 0) %>
<% } -%>
retain_public: true
retain_objc_accessible: true
retain_assign_only_properties: true
retain_unused_protocol_func_params: true
retain_swift_ui_previews: true
retain_codable_properties: true
