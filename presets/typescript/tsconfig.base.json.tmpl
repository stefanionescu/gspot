{
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
<% if (has('nestjs')) { %>        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
<% } else { %>        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
<% } %>        "noPropertyAccessFromIndexSignature": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "target": "ES2022",<% if (has('nextjs')) { %>
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "noEmit": true,
        "plugins": [{"name": "next"}],<% } else { %>
        "module": "NodeNext",
        "moduleResolution": "NodeNext",<% } %>
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "types": <%= json(settings['tools.typescript.types'] ?? []) %><% const paths = tool('typescript').paths; if (paths && Object.keys(paths).length > 0) { %>,
        "paths": <%= json(paths, 8).replace(/\n/g, '\n        ') %><% } %><% const extras = extra('typescript'); if (extras) { for (const [key, value] of Object.entries(extras)) { if (key !== 'reason') { %>,
        "<%= key %>": <%= json(value) %><% } } } %>
    },
    "exclude": ["${configDir}/node_modules", "${configDir}/dist", "${configDir}/build", "${configDir}/coverage", "${configDir}/.gspot"]
}
