# Every disable below is the preset's, not the repository's, and each one is here
# because the check fires on correct code rather than because it is inconvenient.

shell=bash
source-path=SCRIPTDIR
external-sources=true
enable=all

# SC1090, SC1091  non-constant and unfollowable source paths, which SCRIPTDIR dispatch makes unavoidable
# SC2029          remote command expansion, which is deliberate in a deploy script
# SC2154          variables assigned by a sourced configuration file
# SC2310, SC2312  set -e interaction warnings that fire on every correct `if function; then`
disable=SC1090,SC1091,SC2029,SC2154,SC2310,SC2312
