[sqlfluff]
# `sql_file_exts` is the defect this line exists to prevent: it defaults to `.sql`
# alone, so nine `.pgsql` helper files in the reference tree matched nothing and
# nobody noticed, because the configuration read as though they were covered.
sql_file_exts = .sql,.pgsql,.psql
dialect = ansi
max_line_length = {{ format.print_width | raw }}

[sqlfluff:indentation]
tab_space_size = {{ format.indent_width | raw }}
