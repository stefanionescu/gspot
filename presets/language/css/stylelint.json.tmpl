{
    "extends": "stylelint-config-standard",
    "ignoreFiles": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/.gspot/**"],
    "rules": <%= json(Object.assign({
        "no-descending-specificity": true,
        "at-rule-no-unknown": has('nextjs') || tools.includes('tailwindcss') ? [true, { "ignoreAtRules": ["tailwind", "apply", "layer", "theme", "utility", "variant", "custom-variant", "source", "plugin", "config", "reference"] }] : true,
        "function-no-unknown": [true, { "ignoreFunctions": ["theme"] }],
        "import-notation": "string",
        "property-no-vendor-prefix": [true, { "ignoreProperties": ["-webkit-text-size-adjust", "-webkit-backdrop-filter"] }]
    }, settings['tools.stylelint.rules'], Object.fromEntries(rulesOff('css/stylelint').map((rule) => [rule, null])))) %>
}
