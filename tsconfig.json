{
    "compilerOptions": {
        "strict": true,
        "target": "ESNext",
        "module": "Preserve",
        "moduleDetection": "force",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["bun"],
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noPropertyAccessFromIndexSignature": true,
        "resolveJsonModule": true,
        "paths": {
            "#cli/*": ["./packages/cli/src/*"],
            "#tests/*": ["./tests/*"],
            "#cli-package": ["./packages/cli/package.json"],
            "#eslint-plugin/*": ["./packages/eslint-plugin/src/*"],
            "#eslint-plugin-package": ["./packages/eslint-plugin/package.json"],
            "#root-package": ["./package.json"],
            "#docs/*": ["./docs/src/*"],
            "ajv/*": ["./node_modules/.test-tools/node_modules/ajv/*"],
            "eslint": ["./node_modules/.test-tools/node_modules/eslint"],
            "html-validate": ["./node_modules/.test-tools/node_modules/html-validate"],
            "prettier": [
                "./node_modules/.test-tools/node_modules/prettier/index.d.ts",
                "./node_modules/.test-tools/node_modules/prettier/index.mjs"
            ],
            "prettier/*": ["./node_modules/.test-tools/node_modules/prettier/*"],
            "stylelint": [
                "./node_modules/.test-tools/node_modules/stylelint/types/stylelint/index.d.ts",
                "./node_modules/.test-tools/node_modules/stylelint/lib/index.mjs"
            ],
            "typescript": ["./node_modules/.test-tools/node_modules/typescript"]
        }
    },
    "include": ["tests/**/*.ts", "packages/cli/src/types/**/*.d.ts"]
}
